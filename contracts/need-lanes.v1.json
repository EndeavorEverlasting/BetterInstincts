            {
              "id": "SLEEP_ON_GROUND",
              "labels": ["sleep here", "sleep on the ground"],
              "objects": ["observed_sleepable_ground"],
              "steps": ["INSPECT_GROUND_MENU", "SELECT_ENABLED_SLEEP_HERE"]
