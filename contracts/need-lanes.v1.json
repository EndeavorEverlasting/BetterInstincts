          "contention_class": "shared",
          "activities": [
            {
              "id": "WASH_HANDS",
              "labels": ["wash hands", "brush teeth"],
              "objects": ["sink"],
              "steps": ["CLICK_SINK", "PIE_WASH"]
            }
          ]
        }
      }
