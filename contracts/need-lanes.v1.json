{
  "schema": "betterinstincts.need-lanes/v1",
  "version": 1,
  "authority": "docs/NEED_SERVICES.md",
  "proof_ceiling": "HOST_NEED_LANE_CATALOG_NOT_EA_TUNING_API",
  "note": "Peer lane catalogs for hunger/bladder/energy/hygiene/social. Fun remains contracts/fun-service.v1.json (richer playful catalog). Reuse betterinstincts.need_service_base.",
  "services": {
    "hunger": {
      "service_id": "need.hunger",
      "lane_priority": ["quick_meal", "cook", "grill_or_microwave"],
      "lanes": {
        "quick_meal": {
          "service_id": "need.hunger.quick_meal",
          "contention_class": "shared",
          "activities": [
            {
              "id": "QUICK_MEAL",
              "labels": ["have a quick meal", "quick meal", "grab a quick meal"],
              "objects": ["fridge"],
              "steps": ["CLICK_FRIDGE", "PIE_QUICK_MEAL"]
            }
          ]
        },
        "cook": {
          "service_id": "need.hunger.cook",
          "contention_class": "shared",
          "activities": [
            {
              "id": "COOK_MEAL",
              "labels": ["cook", "cook a meal", "make food"],
              "objects": ["fridge", "stove"],
              "steps": ["CLICK_FRIDGE_OR_STOVE", "PIE_COOK"]
            }
          ]
        },
        "grill_or_microwave": {
          "service_id": "need.hunger.alt_heat",
          "contention_class": "shared",
          "activities": [
            {
              "id": "MICROWAVE_OR_GRILL",
              "labels": ["microwave", "grill food"],
              "objects": ["microwave", "grill"],
              "steps": ["CLICK_MICROWAVE_OR_GRILL", "PIE_HEAT_FOOD"]
            }
          ]
        }
      }
    },
    "bladder": {
      "service_id": "need.bladder",
