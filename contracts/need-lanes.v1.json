              "objects": ["toilet"],
              "steps": ["CLICK_TOILET", "PIE_USE_TOILET"]
            }
          ]
        },
        "outdoor_relief": {
          "service_id": "need.bladder.outdoor",
          "contention_class": "shared",
          "activities": [
            {
              "id": "PRIVY_BUSH",
              "labels": ["use bush", "privy bush"],
              "objects": ["privy_bush", "bush"],
              "steps": ["CLICK_BUSH", "PIE_RELIEVE"]
            }
          ]
        }
      }
    },
    "energy": {
      "service_id": "need.energy",
      "lane_priority": ["sleep", "nap", "power_nap_seat", "observed_ground_sleep"],
