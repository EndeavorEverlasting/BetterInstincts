  "guarantees": [
    "Named targets resolve only for allowed modes and calibrated profiles",
    "Uncalibrated Live panel stubs never invent click points",
    "Hotkeys are glossary entries; they never prove mode or grant execute_allowed",
    "Recipes default execute_allowed=false",
    "No second screen daemon; adapters consume plans after independent admission",
    "Extensible: add Live phone/app maps and panel cells without replacing ui_mode",
    "Plans prefer HOTKEY/KEY over CLICK_TARGET whenever a catalogued equivalent exists",
    "Mouse clicks remain annotated MOUSE_FALLBACK when no hotkey equivalent exists"
  ],
  "input_preference": {
    "selected": "HOTKEY_FIRST_WHEN_EQUIVALENT",
    "order": [
      "HOTKEY",
      "KEY",
      "TYPE_TEXT",
      "CLICK_TARGET"
    ],
    "interop_rationale": "Keyboard chords avoid relocating the cursor into chrome/lot fights and share the cooperative 15s idle gate without mouse contention.",
    "mouse_fallback": "Only when no catalogued hotkey equivalent exists for the effect",
    "forbidden": [
      "BACKGROUND_KEYLOGGER",
      "GLOBAL_KEYHOOK",
      "HOTKEY_PROVES_MODE",
      "HOTKEY_GRANTS_EXECUTE"
    ]
