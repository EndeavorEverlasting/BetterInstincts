  "recipes": {
    "catalog_to_household_inventory": {
      "id": "catalog_to_household_inventory",
      "destination": "HOUSEHOLD_INVENTORY",
      "forbidden": ["LOT_PLACEMENT", "PERSONAL_POCKET", "HALLUCINATED_GSI_CREATE_OBJ"],
      "required_modes": ["BUY", "BUILD"],
      "mutating_action": "BACKSPACE_TO_INVENTORY",
      "execute_allowed_default": false,
      "steps": [
        {"op": "REQUIRE_MODE", "modes": ["BUY", "BUILD"]},
        {"op": "CLICK_TARGET", "target": "catalog.search_field"},
        {"op": "TYPE_TEXT", "from_recipe_field": "search_term"},
        {"op": "KEY", "chord": ["ENTER"]},
        {"op": "CLICK_TARGET", "target": "catalog.first_result"},
        {"op": "OBSERVE", "cue": "held_object_cancel_esc", "fail": "ITEM_NOT_HELD"},
        {"op": "KEY", "chord": ["BACKSPACE"], "hotkey_id": "BACKSPACE_TO_HOUSEHOLD_INVENTORY"},
        {"op": "CLICK_TARGET", "target": "catalog.household_inventory_tab"},
        {"op": "OBSERVE", "cue": "household_inventory_contains_item", "fail": "ITEM_NOT_IN_HOUSEHOLD_INVENTORY"}
      ]
    }
  },
  "catalog_items": {
    "a_ok_bloomer": {
