  "recipes": {
    "catalog_to_household_inventory": {
      "id": "catalog_to_household_inventory",
      "destination": "HOUSEHOLD_INVENTORY",
      "forbidden": [
        "LOT_PLACEMENT",
        "PERSONAL_POCKET",
        "HALLUCINATED_GSI_CREATE_OBJ"
      ],
      "required_modes": [
        "BUY",
        "BUILD"
      ],
      "mutating_action": "BACKSPACE_TO_INVENTORY",
      "execute_allowed_default": false,
      "steps": [
        {
          "op": "REQUIRE_MODE",
          "modes": [
            "BUY",
            "BUILD"
          ]
        },
        {
          "op": "KEY",
          "chord": [
            "F3"
          ],
          "hotkey_id": "MODE_BUILD",
          "when_mode": "BUILD",
          "note": "Prefer F3 over HUD hammer click when requesting Build"
        },
        {
          "op": "KEY",
          "chord": [
            "F2"
          ],
          "hotkey_id": "MODE_BUY",
          "when_mode": "BUY",
          "note": "Prefer F2 over HUD Buy click when requesting Buy"
        },
        {
          "op": "CLICK_TARGET",
          "target": "catalog.search_field",
          "preferred_channel": "MOUSE_FALLBACK"
        },
        {
          "op": "TYPE_TEXT",
          "from_recipe_field": "search_term"
        },
        {
          "op": "KEY",
          "chord": [
            "ENTER"
          ]
        },
        {
          "op": "CLICK_TARGET",
          "target": "catalog.first_result",
          "preferred_channel": "MOUSE_FALLBACK"
        },
        {
          "op": "OBSERVE",
          "cue": "held_object_cancel_esc",
          "fail": "ITEM_NOT_HELD"
        },
        {
          "op": "KEY",
          "chord": [
            "BACKSPACE"
          ],
          "hotkey_id": "BACKSPACE_TO_HOUSEHOLD_INVENTORY"
        },
        {
          "op": "CLICK_TARGET",
          "target": "catalog.household_inventory_tab",
          "preferred_channel": "MOUSE_FALLBACK"
        },
        {
          "op": "OBSERVE",
          "cue": "household_inventory_contains_item",
          "fail": "ITEM_NOT_IN_HOUSEHOLD_INVENTORY"
        }
      ],
      "input_preference": "HOTKEY_FIRST_WHEN_EQUIVALENT"
    }
  },
