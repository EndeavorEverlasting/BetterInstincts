  "architecture": {
    "selected": "UI_CHROME_PEER_MAP",
    "rejected": [
      {
        "id": "PER_FRAME_VISION_CLICKER",
        "why": "Missed clicks and hallucinated targets; operators need named regions by definition."
      },
      {
        "id": "STUFF_INTO_UI_MODE",
        "why": "ui_mode owns mode classification; chrome maps and hotkeys are a separable peer."
      },
      {
        "id": "ABSOLUTE_PIXELS_ONLY",
        "why": "Resolution drift; prefer normalized client fractions plus a profile."
      },
      {
        "id": "MOUSE_ALWAYS",
        "why": "Cursor relocation fights the operator under ASYNC_INTEROP and amplifies lot punch-through; prefer catalogued hotkeys when equivalent."
      }
    ]
  },
