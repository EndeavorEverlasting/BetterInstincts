  "call_stack": {
    "order": [
      "PLAYER_FIRST_OR_BUSY",
      "BUILD_OR_BUY_YIELD",
      "SCHOOL_DAY_OUTRANKS_NAVIGATING_NEEDS",
      "URGENT_NEED_WITHOUT_PANEL_GOAL",
      "NAVIGATING_NEEDS_TANDEM",
      "NAVIGATING_NEEDS_INACTIVE",
      "LEISURE_OR_IDLE"
    ],
    "gates": {
      "PLAYER_FIRST_OR_BUSY": {
        "when": ["player_directed", "already_busy"],
        "action": "YIELD_OR_EMULATE_ONLY"
      },
      "BUILD_OR_BUY_YIELD": {
        "when": ["build_or_buy_mode"],
        "action": "ABSTAIN_NAVIGATING_NEEDS_WHILE_BUILDING",
        "forbidden": ["FORCE_F1", "NEEDS_OBJECT_CLICK"]
      },
      "SCHOOL_DAY_OUTRANKS_NAVIGATING_NEEDS": {
        "when": ["school_day_active"],
        "action": "DEFER_NAVIGATING_NEEDS_TO_SCHOOL_DAY"
      },
      "URGENT_NEED_WITHOUT_PANEL_GOAL": {
        "when": ["uncovered_urgent_worse_than_panel_covered_urgent"],
        "action": "FALL_THROUGH_TO_INSTINCTS_FOR_UNCOVERED_URGENT",
        "note": "Fall through only when the worst urgent motive is not among visible panel goals; if the panel covers the worst urgent (e.g. cook while social also urgent), stay in tandem"
      },
      "NAVIGATING_NEEDS_TANDEM": {
        "when": ["navigating_needs_active", "goals_incomplete", "panel_covers_urgent_or_no_urgent"],
        "action": "QUEUE_PANEL_ALIGNED_NEED_REMEDY",
        "goal_catalog": "contracts/navigating-needs.v1.json"
      },
      "NAVIGATING_NEEDS_INACTIVE": {
        "when": ["not_navigating_needs_active"],
        "action": "NO_NAVIGATING_NEEDS_ROUTING"
      },
      "LEISURE_OR_IDLE": {
        "action": "ALLOW_DEFAULT_INSTINCTS"
      }
    }
  },
