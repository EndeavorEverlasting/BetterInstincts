{
  "schema": "betterinstincts.host-listener/v1",
  "version": 1,
  "glossary": "contracts/glossary.v1.json",
  "behavior_matrix": "contracts/behavior-matrix.v1.json",
  "proof_ceiling": "OPT_IN_BOUNDED_LISTENER_NOT_DAEMON_OR_LIVE_CERT",
  "activation": {
    "default": "INACTIVE",
    "require_explicit_activate": true,
    "forbid_autorun": true,
    "forbid_github_actions_as_listener": true,
    "forbid_background_thread_in_library": true
  },
  "bounds": {
    "max_session_bytes": 64000,
    "max_observation_bytes": 32000,
    "max_ticks_per_session": 64,
    "max_queue_items": 16,
    "min_tick_interval_sec": 1,
    "max_tick_interval_sec": 120,
    "receipt_root": "dist/host-listener"
  },
  "async_session": {
    "owner": "betterinstincts/host_tandem.py",
    "activation": "Explicit call with an already ACTIVE listener session; no autorun or background thread",
    "one_session_writer_per_actor": true,
    "max_events_in_memory": 64,
    "observation_timeout_default_seconds": 15,
    "observation_timeout_max_seconds": 30,
    "action_timeout_default_seconds": 120,
    "action_timeout_max_seconds": 600,
    "ports": [
      "observe",
      "execute_until_observed_outcome",
      "interrupt_only_verified_host_action",
      "presence_probe"
    ],
    "preemption": "Fresh actor and host_activity_ref/owner binding plus independent screen admission; never cancel player-owned or unknown activity",
    "callback_cancellation": "Stop callback control/observation, never send Sim cancellation input; adapters must cooperate with coroutine cancellation",
    "completion": "Observed action outcome is distinct from ACK; session exhaustion is not mission completion",
    "mode_gate": "Explicit scene-backed non-Live/Unknown mode ends the current bounded coordinator without new host action; never cancel the player queue"
  },
  "inputs": {
    "observation_schema": "betterinstincts.host-listener.observation/v1",
    "required_fields": [
      "needs",
      "queue",
      "location_kind",
      "capture_ref"
    ],
    "location_kinds": [
      "home",
      "school",
      "community",
      "work",
      "unknown"
    ],
    "note": "Observations are operator/sensor JSON. Listener does not invent queue contents from screenshots unless a future calibrated sensor is separately certified.",
    "optional_school_day_fields": [
      "school_day_active",
      "school_goals_incomplete",
      "school_phase",
      "pinned_whims",
      "homework_pending",
      "inventory_has_homework",
      "homework_on_lot",
      "available_objects",
      "sim_at_school",
      "camera_lot_kind",
      "life_stage",
      "emotion",
      "moodlets",
      "traits",
      "whims",
      "lot_model",
      "multitasking",
      "sim_room_id",
      "sim_seated",
      "sim_seat_id",
      "lot_traits"
    ],
    "optional_social_opportunity_fields": [
      "social_prompt_active",
      "social_prompt_kind",
      "social_prompt_text",
      "social_invitee_name",
      "sim_library",
      "social_lookup_ran",
      "invitee_occult_status"
    ],
    "optional_scenario_fields": [
      "scenario_active",
      "scenario_goals_incomplete",
      "scenario_profile",
      "allow_career",
      "needs_game_certified",
      "income_game_observed"
    ],
    "optional_navigating_needs_fields": [
      "navigating_needs_active",
      "navigating_needs_incomplete",
      "navigating_needs_profile",
      "build_or_buy_mode"
    ],
    "optional_build_floor_activity_fields": [
      "build_or_buy_mode",
      "active_story",
      "stories_touched",
      "floor_items"
    ],
    "optional_gardening_fields": [
      "gardening"
    ],
    "optional_tandem_binding_fields": [
      "actor_ref",
      "host_activity_ref",
      "host_activity_owner"
    ],
    "optional_mode_context_fields": [
      "game_version",
      "mode_observations",
      "panel_observations",
      "shortcut_hint"
    ],
    "mode_context_contract": "contracts/ui-mode.v1.json",
    "optional_chance_event_fields": [
      "chance_event",
      "chance_event_external_research_opt_in"
    ],
    "chance_event_contract": "docs/CHANCE_EVENT_RESEARCH.md",
    "chance_event_scope": "Supplied, two-cue scene observation must share capture_ref; local memo read; evaluate-only companion. External work dispatch opt-in, never launched by listener. In player-yield state the event advisory is still read-only, never a game click.",
    "homework_study_preflight": {
      "owner": "betterinstincts/teen_homework.py",
      "queue_owner": "betterinstincts/queue_capacity.py",
      "lot_source": "betterinstincts/room_census.py over house_state",
      "required_before_homework_enqueue": [
        "inventory_has_homework=true",
        "homework_pending=true",
        "multitasking explicitly observed false or true",
        "queue available below conservative cap",
        "attested indoor table/desk plus chair",
        "sim_room_id equals chosen room",
        "sim_seated true",
        "sim_seat_id equals chosen seat",
        "no duplicate homework in current queue"
      ],
      "on_missing": "emit advisory scan/seat/wait; do not enqueue",
      "proof_ceiling": "OFFLINE_HOST_LISTENER_NO_SENDINPUT"
    }
  },
  "pipeline": [
    "load_session",
    "validate_observation",
    "classify_optional_mode_context_from_two_distinct_scene_cues",
    "assess_optional_supplied_chance_event_for_read_only_companion",
    "player_presence_classify",
    "yield_if_player_playing",
    "hold_live_planning_for_buy_build_unknown_mode",
    "behavior_eval",
    "instincts_plan",
    "study_location_and_queue_capacity_advisory_if_homework",
    "host_stack_evaluate_turn",
    "school_day_goal_plan_if_active",
    "navigating_needs_tandem_if_active",
    "scenario_goal_plan_if_active",
    "build_floor_activity_if_build_buy",
    "needs_force_route_if_optimize",
    "emit_receipt"
  ],
  "player_presence": "contracts/player-presence.v1.json",
  "on_emulate": {
    "action": "RECORD_EMULATION_PLAN",
    "execute_clicks": false,
    "note": "Default listener is evaluate-only. Live SendInput requires separate --execute on needs_force/host_menu with disposable confirmation."
  },
  "on_optimize": {
    "action": "RECORD_OPTIMIZATION_PLAN",
    "prefer": "MAP_TRAVEL",
    "forbid": [
      "IN_FRAME_WALK_THRASH",
      "RESUME",
      "DELETE_SAVE"
    ]
  },
  "host_commands": {
    "activate": "python -m scripts.host_listener activate --session-id ID",
    "status": "python -m scripts.host_listener status --session-id ID",
    "tick": "python -m scripts.host_listener tick --session-id ID --observation PATH",
    "deactivate": "python -m scripts.host_listener deactivate --session-id ID"
  }
}
