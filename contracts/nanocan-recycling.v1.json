    "https://modthesims.info/d/667082/off-grid-nanocan-trash-can.html"
  ],
  "p08_checks": [
    "pin_exact_installed_game_build",
    "inspect_read_only_EA_NanoCan_and_dish_disposal_tuning",
    "compare_player_drag_and_Sim_disposal_funds_with_two_dishes",
    "prove_native_cursor_free_reward_equivalence_or_record_unavailable",
    "prove_sink_native_autonomy_candidate_only_when_NanoCan_ready",
    "prove_player_manual_wash_remains_allowed",
    "probe_cooldown_and_stacks",
    "rollback_disposable_save_native_package",
    "retain_BI002_hunger_gate"
  ],
  "proof_ceiling": "OFFLINE_CURSOR_FREE_NANOCAN_POLICY_NOT_INSTALLED_EA_HOOK_OR_MONEY"
}
