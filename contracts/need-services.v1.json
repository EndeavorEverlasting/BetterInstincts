{
  "schema": "betterinstincts.need-services/v1",
  "version": 1,
  "authority": "docs/NEED_SERVICES.md",
  "proof_ceiling": "HOST_NEED_SERVICES_REGISTRY_NOT_DAEMON_NOT_EA_API",
  "design_brief": {
    "subject": "Six-need tandem service registry for parallel host planning",
    "audience": "local host agents joining BetterInstincts without reinventing need planners",
    "job": "Declare each motive as an independent service that can plan in tandem; compose via need_services orchestrator; Fun keeps its rich catalog, other needs use need-lanes",
    "architecture": "P124 factor: need_service_base primitives + per-need owners. No monolith mega-queue. No background daemon.",
    "upstreams": [
      {"id": "impeccable", "mechanism": "purpose before chrome"},
      {"id": "UP-A85AD9DC3", "mechanism": "call-stack storytelling"},
      {"id": "UP-40FE662CF", "mechanism": "validate before push"}
    ]
  },
  "registry": {
    "hunger": {
      "owner": "betterinstincts/need_services.py",
      "lanes_contract": "contracts/need-lanes.v1.json#services.hunger",
      "related": ["contracts/navigating-needs.v1.json", "contracts/needs-force.v1.json"]
    },
    "bladder": {
      "owner": "betterinstincts/need_services.py",
      "lanes_contract": "contracts/need-lanes.v1.json#services.bladder",
      "related": ["contracts/navigating-needs.v1.json"]
    },
    "energy": {
      "owner": "betterinstincts/need_services.py",
      "lanes_contract": "contracts/need-lanes.v1.json#services.energy",
      "related": ["contracts/navigating-needs.v1.json"]
    },
    "hygiene": {
      "owner": "betterinstincts/need_services.py",
      "lanes_contract": "contracts/need-lanes.v1.json#services.hygiene",
      "related": ["contracts/navigating-needs.v1.json"]
    },
    "fun": {
      "owner": "betterinstincts/fun_service.py",
      "lanes_contract": "contracts/fun-service.v1.json",
      "related": ["contracts/event-goals.v1.json"]
    },
    "social": {
      "owner": "betterinstincts/need_services.py",
      "lanes_contract": "contracts/need-lanes.v1.json#services.social",
      "related": ["contracts/event-balance.v1.json", "contracts/social-opportunity.v1.json"]
    }
  },
  "composition": {
    "orchestrator": "betterinstincts/need_services.py#evaluate_need_services",
    "base": "betterinstincts/need_service_base.py",
    "load_balance": "betterinstincts/need_load_balance.py#balance_need_services",
    "lb_contract": "contracts/need-load-balance.v1.json",
    "host_gate": "NEED_SERVICES_TANDEM | NEED_SERVICES_LOAD_BALANCE",
    "rule": "Plan all attached need services independently; health-check each microsystem; detach unhealthy call stacks and open assumption windows; load-balance primary among healthy READY plans; never serialize every Sim onto one contended object"
  },
  "anti_patterns": [
    "REINVENT_NEED_PARSER_PER_AGENT",
    "MONOLITH_SINGLE_QUEUE_FOR_ALL_NEEDS",
    "BACKGROUND_NEED_DAEMON",
    "STICK_TO_DEAD_CALL_STACK",
    "SELECT_UNHEALTHY_AS_PRIMARY"
  ]
}
