{
  "schema": "betterinstincts.household-upkeep-policy/v1",
  "owner": "betterinstincts/household_upkeep.py",
  "input_schema": "betterinstincts.household-upkeep/v1",
  "host_integration": "betterinstincts/host_stack.py",
  "listener_owner": "betterinstincts/host_listener.py",
  "queue_owner": "betterinstincts/queue_capacity.py",
  "budget_owner": "betterinstincts/budget_eval.py",
  "scope": "Opt-in, bounded polling per household current-capture; no library daemon, OS background timer or unconditional global scan",
  "servo_needs": [
    "durability",
    "charge",
    "fun",
    "social"
  ],
  "servo_thresholds": {
    "durability_critical": 0.2,
    "durability_watch": 0.5,
    "charge_critical": 0.15,
    "charge_watch": 0.35,
    "fun_watch": 0.35,
    "social_watch": 0.35
  },
  "policy_defaults": "Conservative advisory thresholds, NOT exact EA tuning or measured runtime behavior.",
  "bounds": {
    "max_servos": 16,
    "max_actors": 16,
    "max_observed_actions": 64,
    "max_capture_age_seconds": 180,
    "next_observation_recommendation_seconds": 30,
    "max_new_queue_actions": 1
  },
  "bill_policy": {
    "observe_due_and_unpaid": true,
    "pre_due_window_sim_hours": 72,
    "require_amount_and_funds": true,
    "require_pay_bills_authorized": true,
    "require_exact_fresh_pay_bills_affordance": true,
    "require_independent_paid_receipt": true,
    "after_dispatched_without_paid_proof": "STOP_AND_REOBSERVE_NO_DOUBLE_CHARGE",
    "insufficient_funds": "REPORT_BUDGET_SHORTFALL_TO_EXISTING_INCOME_LANE",
    "spend_class": "OBLIGATION_NOT_BUILD_BUY_PURCHASE"
  },
  "safety": {
    "never_override_player_queue": true,
    "never_add_while_human_survival_critical": true,
    "never_rely_on_unknown_queue_origin": true,
    "never_queue_when_actor_busy_or_queue_full": true,
    "never_treat_proposed_action_as_executed": true,
    "no_github_host_inputs": true,
    "no_game_save_or_structure_mutations": true,
    "never_use_ea_connect": true,
    "water_exposure_wet": "BLOCK_UNVERIFIED_SERVO_ACTION_AND_ALERT",
    "prioritize_other_human_sims_for_tune_up": true,
    "prohibit_repeating_queued_or_dispatched_attempts": true,
    "local_input_gate": "independent screen_admit + current UI/menu + player idleness + exact actor/target"
  },
  "proof_ceiling": "OFFLINE_UPKEEP_PLANNING_NOT_LIVE_SIMS_SERVO_OR_BILL_PROOF"
}
