{
  "schema": "betterinstincts.household-upkeep-policy/v1",
  "owner": "betterinstincts/household_upkeep.py",
  "input_schema": "betterinstincts.household-upkeep/v1",
  "host_integration": "betterinstincts/host_stack.py",
  "listener_owner": "betterinstincts/host_listener.py",
  "queue_owner": "betterinstincts/queue_capacity.py",
  "budget_owner": "betterinstincts/budget_eval.py",
  "scope": "Opt-in, bounded polling per household current-capture; no library daemon, OS background timer or unconditional global scan",
  "servo_needs": [
    "durability",
    "charge",
    "fun",
    "social"
  ],
  "servo_thresholds": {
    "durability_critical": 0.2,
    "durability_watch": 0.5,
    "charge_critical": 0.15,
    "charge_watch": 0.35,
    "fun_watch": 0.35,
    "social_watch": 0.35
  },
  "policy_defaults": "Conservative advisory thresholds, NOT exact EA tuning or measured runtime behavior.",
  "bounds": {
    "max_servos": 16,
    "max_actors": 16,
    "max_observed_actions": 64,
    "max_capture_age_seconds": 180,
    "next_observation_recommendation_seconds": 30,
    "max_new_queue_actions": 1
  },
  "bill_policy": {
    "observe_due_and_unpaid": true,
    "pre_due_window_sim_hours": 72,
    "require_amount_and_funds": true,
    "require_pay_bills_authorized": true,
    "require_exact_fresh_pay_bills_affordance": true,
    "require_independent_paid_receipt": true,
    "after_dispatched_without_paid_proof": "STOP_AND_REOBSERVE_NO_DOUBLE_CHARGE",
    "insufficient_funds": "REPORT_BUDGET_SHORTFALL_TO_EXISTING_INCOME_LANE",
    "spend_class": "OBLIGATION_NOT_BUILD_BUY_PURCHASE"
  },
  "servo_helper_policy": {
    "allow_servo_peer_helpers": true,
    "prefer_human_helpers_first": true,
    "forbid_self_helper_on_peer_path": true,
    "min_robotics_level": 3,
    "required_verified_skill": "robotics",
    "skill_gap_gate": "UPKEEP_HELPER_SKILL_GAP",
    "skill_force_bundle": "servo_core",
    "notes": "Conservative Robotics floor for peer Servo Tune Up/Repair proposals. Exact live menu unlocks remain observation-gated. HUMAN helpers stay preferred when available. SOCIALIZE_SERVO and PAY_BILLS remain HUMAN-only."
  },
  "servo_fire_risk": {
    "incident": "2026-11-09: a Servo with low Durability plus laundry (dryer lint) caused fires",
    "durability_gate": "Servo BROKEN or durability <= servo_thresholds.durability_critical blocks laundry autonomy until Repair/Tune Up is done and reobserved; unverified durability holds laundry autonomy (unknown -> no action)",
    "block_laundry_when": ["BROKEN", "CRITICAL_DURABILITY", "DURABILITY_UNVERIFIED", "STALE_OBSERVATION"],
    "prerequisite_actions": ["REPAIR_SERVO", "TUNE_UP_SERVO"],
    "dryer_policy": {
      "clean_lint_trap_before_each_dryer_run": true,
      "lint_less_upgrade": "Lint-Less (Handiness dryer upgrade) removes the lint-fire risk",
      "lint_less_requires": "Handiness upgrade availability is observation-gated (pack/skill dependent)",
      "unsupervised_dryer": "FORBIDDEN_UNLESS_LINT_LESS_INSTALLED"
    },
    "clothesline_preferred_when_unsupervised": true,
    "default_supervised": false,
    "states": [
      "BLOCKED_REPAIR_FIRST",
      "HOLD_DURABILITY_UNVERIFIED",
      "HOLD_REOBSERVE_STALE",
      "USE_CLOTHESLINE",
      "DRYER_ALLOWED_LINT_LESS",
      "CLEAN_LINT_THEN_DRYER_SUPERVISED",
      "DRYER_ALLOWED_SUPERVISED_LINT_CLEAN",
      "HOLD_UNSUPERVISED_NO_LINT_LESS",
      "NOT_APPLICABLE_NO_SERVOS"
    ],
    "proof_ceiling": "OFFLINE_SERVO_FIRE_POLICY_NOT_LIVE_FIRE_PREVENTION_PROOF"
  },
  "safety": {
    "never_override_player_queue": true,
    "never_add_while_human_survival_critical": true,
    "never_rely_on_unknown_queue_origin": true,
    "never_queue_when_actor_busy_or_queue_full": true,
    "never_treat_proposed_action_as_executed": true,
    "no_github_host_inputs": true,
    "no_game_save_or_structure_mutations": true,
    "never_use_ea_connect": true,
    "water_exposure_wet": "BLOCK_UNVERIFIED_SERVO_ACTION_AND_ALERT",
    "prioritize_other_human_sims_for_tune_up": true,
    "allow_verified_robotics_servo_peer_helpers": true,
    "prohibit_repeating_queued_or_dispatched_attempts": true,
    "local_input_gate": "independent screen_admit + current UI/menu + player idleness + exact actor/target"
  },
  "proof_ceiling": "OFFLINE_UPKEEP_PLANNING_NOT_LIVE_SIMS_SERVO_OR_BILL_PROOF"
}
