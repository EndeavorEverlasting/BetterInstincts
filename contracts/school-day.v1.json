      },
      "HOMEWORK_AT_HOME": {
        "when": ["homework_pending", "location_home", "survival_ok"],
        "action": "QUEUE_HOMEWORK_AT_HOME"
      },
      "SCHOOL_DAY_INACTIVE": {
        "when": ["not_school_day_active"],
        "action": "NO_SCHOOL_DAY_ROUTING"
