        "action": "DEFER_SCENARIO_TO_SCHOOL_DAY"
      },
      "SCENARIO_GOAL_PROGRESS": {
        "when": ["scenario_active", "scenario_goals_incomplete", "survival_ok", "not_school_day_active"],
        "action": "QUEUE_INCOMPLETE_SCENARIO_GOALS",
        "goal_catalog": "contracts/scenario-goals.v1.json"
      },
      "SCENARIO_CAREER_DEFERRED": {
        "when": ["scenario_active", "career_goal_only", "career_horizon_blocked"],
        "action": "DEFER_CAREER_UNTIL_INCOME_PROOF",
        "forbidden": ["FORCE_CAREER_BEFORE_EARN_CRAFT", "MOTHERLODE_FOR_SCENARIO"]
      },
      "SCENARIO_INACTIVE": {
        "when": ["not_scenario_active"],
        "action": "NO_SCENARIO_ROUTING"
