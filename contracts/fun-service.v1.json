{
  "schema": "betterinstincts.fun-service/v1",
  "version": 1,
  "authority": "docs/FUN_SERVICE.md",
  "proof_ceiling": "HOST_FUN_LANE_CATALOG_NOT_EA_TUNING_API",
  "design_brief": {
    "subject": "Fun need recovery with parallel activity lanes under guest contention",
    "audience": "local host agent mid-Live / mid-party",
    "job": "Own Fun as an independent service (not a monolith queue tail): keep multiple free Fun options so Sims never pile onto one contended object while guests occupy lot activities",
    "architecture": "Each Fun lane is its own service plan. Host_stack composes lane results in tandem with survival/event/school services — not one serialized mega-queue. No background daemon.",
    "upstreams": [
      {"id": "impeccable", "mechanism": "purpose before chrome"},
      {"id": "UP-A85AD9DC3", "mechanism": "call-stack / journey storytelling"},
      {"id": "UP-40FE662CF", "mechanism": "validate before push"}
    ],
    "forbidden_chrome": "No Fun dashboard UI; contracts + evaluators only"
  },
  "local_observed": {
    "date": "2026-11-07",
    "observation": "Sims under-serve Fun on their own; with guests they queue behind each other and contend for the same activities",
    "capture_ref": "operator:fun-contention-guests-20261107"
  },
  "thresholds_ref": "contracts/needs.v1.json",
  "architecture_rules": [
    "FUN_SERVICE is a peer host evaluator — never buried only inside a generic have_fun stub",
    "Lanes plan independently; host picks free lanes without forcing all Sims onto one object",
    "When guests_present or occupied_objects, prefer personal_portable and uncontended lanes",
    "Playful-exclusive actions require PLAYFUL emotion or playful moodlet — fail closed otherwise",
    "Survival bladder/hunger/energy outrank Fun lanes",
    "During EVENT_FUN_VIA_GOALS, defer fluff leave-the-party Fun but keep portable options if fun critical",
    "No background daemon / busy-wait; evaluate-only until separate --execute"
  ],
  "lane_priority_default": [
    "personal_portable",
    "playful_everyday",
    "electronics_shared",
    "creative_hobbies",
    "social_physical",
    "playful_exclusive",
    "child_toddler"
  ],
  "lane_priority_when_guests": [
    "personal_portable",
    "playful_everyday",
    "creative_hobbies",
    "playful_exclusive",
    "electronics_shared",
    "social_physical",
    "child_toddler"
  ],
