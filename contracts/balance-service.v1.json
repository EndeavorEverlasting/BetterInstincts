  "call_stack": {
    "order": [
      "PLAYER_FIRST_OR_BUSY",
      "BALANCE_CONDITION_HELD",
      "SUSPENDED_FOR_SURVIVAL",
      "READY_HOLISTIC_CURE",
      "READY_NATUROPATH",
      "RECOVERING_NATURE",
      "BALANCE_SERVICES_TANDEM",
      "BALANCE_RESTORED",
      "BALANCE_IDLE"
    ],
    "gates": {
      "PLAYER_FIRST_OR_BUSY": {
        "action": "YIELD_OR_EMULATE_ONLY",
