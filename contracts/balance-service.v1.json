    "host_gate": "BALANCE_SERVICES_TANDEM | BALANCE_CONDITION_HELD | READY_HOLISTIC_CURE | READY_NATUROPATH | RECOVERING_NATURE",
    "tandem_peers": ["need_services", "gardening_service", "career_service", "aspiration_service", "host_tandem"],
