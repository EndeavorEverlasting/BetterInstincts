      "BALANCE_ACTION_WHILE_SURVIVAL_CRITICAL",
      "NATUROPATH_BEFORE_NATURE_WHEN_ONLY_IMBALANCED",
      "CLAIM_PACK_CERT_FROM_OFFLINE_MICROSYSTEM"
