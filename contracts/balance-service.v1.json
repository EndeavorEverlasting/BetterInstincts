      },
      "SUSPENDED_FOR_SURVIVAL": {
        "action": "HOLD_BALANCE_CONDITION_WHILE_SURVIVAL",
        "condition_held": true
      },
      "READY_HOLISTIC_CURE": {
        "action": "CONSUME_OR_OBTAIN_HOLISTIC_CURE",
        "condition_held": true
      },
      "READY_NATUROPATH": {
        "action": "OPEN_PHONE_VISIT_NATUROPATH",
        "condition_held": true
      },
      "RECOVERING_NATURE": {
        "action": "ENGAGE_NATURE_AND_POSITIVE_MOOD",
        "condition_held": true
      },
      "BALANCE_SERVICES_TANDEM": {
        "action": "TRACK_BALANCE_BESIDE_NEED_SERVICES",
        "condition_held": true
      },
      "BALANCE_RESTORED": {
        "action": "CLEAR_BALANCE_CONDITION",
        "condition_held": false
      },
      "BALANCE_IDLE": {
        "action": "NO_BALANCE_CONDITION",
        "condition_held": false
      }
