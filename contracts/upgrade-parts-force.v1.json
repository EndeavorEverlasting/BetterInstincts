      "requires_testingcheats": false,
      "scalability_rank": 3,
      "funds_note": "Each purchase spends Simoleons; ensure funds or run funds_inject first on disposable lab.",
      "steps_template": [
        {
          "op": "REQUIRE_MODE",
          "mode": "LIVE",
          "fail": "COMPUTER_PURCHASE_REQUIRES_LIVE"
        },
        {
          "op": "REQUIRE_ACTIVE_SIM_SELECTION"
        },
        {
          "op": "REQUIRE_EXPLICIT_USER_COMMAND"
