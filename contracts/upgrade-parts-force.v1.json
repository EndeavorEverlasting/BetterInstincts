        {
          "op": "DISCOVER_NESTED_MENU",
          "target_label": "Purchase Upgrade Parts",
          "max_menu_pages": 16,
          "choose_only_observed_labels": true,
          "fail": "PURCHASE_MENU_NOT_OBSERVED"
        },
        {
          "op": "SELECT_PART",
          "from_recipe_field": "display_name",
          "fail": "PART_ROW_MISSING"
        },
        {
          "op": "REQUIRE_SPENDING_AUTHORIZATION",
          "funds_and_price_observed": true,
          "inventory_baseline_required": true
        },
        {
          "op": "CONFIRM_PURCHASE"
        },
        {
          "op": "OBSERVE",
          "cue": "part_in_sim_inventory",
          "fail": "PART_NOT_IN_INVENTORY"
        },
        {
          "op": "REPEAT_PURCHASE",
          "times_from": "quantity_remaining_after_first",
