{
  "schema": "betterinstincts.upgrade-parts-force/v1",
  "version": 2,
  "authority": "docs/UPGRADE_PARTS_FORCE.md",
  "proof_ceiling": "HOST_DIY_PARTS_BUDGET_PLAN_AND_CERT_SCHEMA_NOT_BI002",
  "architecture": {
    "selected": "HOUSEHOLD_DIY_PARTS_BUDGET",
    "prior": "UPGRADE_PARTS_FORCE",
    "rejected": [
      "HALLUCINATED_GSI_CREATE_OBJ_HEX",
      "SECOND_COMMERCE_DAEMON",
      "BUILD_BUY_CATALOG_AS_PRIMARY_ACQUISITION",
      "SHARED_HOUSEHOLD_INVENTORY_FOR_CRAFT_PARTS",
      "CLAIM_BI002_FROM_PARTS_PLAN"
    ],
    "peers": [
      "diy_skill_force",
      "funds_inject",
      "household_object_force",
      "ui_chrome",
      "live_cert"
    ],
    "scalability_note": "Prefer one Spawn Crafting Supplies bulk per Sim over N×part spam purchases; phone/computer Order fills buyable gaps only."
  },
  "design_brief": {
    "subject": "Household DIY parts budget — every Sim (N) keeps craft/upgrade parts in pocket inventory",
    "audience": "operators and host agents who need always-ready DIY materials across any household size",
    "job": "Catalog + N-member Space-traverse planner + machine-readable live certification of per-Sim pocket stock",
    "operator_correction": "Stock must be per-Sim pocket so crafts work when a member is at work or removed. Budget all DIY part kinds, not only Robot Salvage Parts."
  },
  "activation": {
    "require_explicit_activate": true,
    "never_on_startup": true,
    "never_autorun": true,
    "never_touch_game_speed": true,
    "cli": {
      "catalog": "python -m scripts.upgrade_parts_force catalog",
      "budget": "python -m scripts.upgrade_parts_force budget",
      "how_to_buy": "python -m scripts.upgrade_parts_force how-to-buy --part robot_salvage_parts",
      "plan": "python -m scripts.upgrade_parts_force plan --part robot_salvage_parts --quantity 20 --path computer",
      "household": "python -m scripts.upgrade_parts_force household --members N --path spawn",
      "certify": "python -m scripts.upgrade_parts_force certify --members N --observations path.json",
      "record": "python -m scripts.upgrade_parts_force record --run-id ID --member-slot 0 --part-id robot_salvage_parts --observed-count 20",
      "status": "python -m scripts.upgrade_parts_force status --run-id ID"
    },
    "interop": {
      "require_screen_admit": true,
      "forbid_computer_use_fallback": true,
      "note": "Library plans stay evaluate-only. Live acquire/observe requires screen_admit + disposable lab."
    }
  },
  "quantity": {
    "default": 20,
    "min": 1,
    "max": 99,
    "tune_up_observed_minimum": 4,
    "gardener_bot_craft_hint": 20,
    "spawn_bulk_hint": 50,
    "budget_target_default": 20
  },
  "household_budget": {
    "selected": "PER_SIM_POCKET_STOCK",
    "destination": "sim_pocket_inventory",
    "forbid_household_inventory": true,
    "preferred_acquisition_order": ["spawn", "phone", "computer"],
    "rejected_primary_acquisition": ["buy_mode_debug_catalog", "gsi_create_obj"],
    "diy_kit_id": "diy_builder_kit",
    "diy_kit_part_ids": [
      "common_upgrade_parts",
      "electronic_upgrade_parts",
      "plumbing_upgrade_parts",
      "kitchen_upgrade_parts",
      "robot_salvage_parts",
      "computer_chip",
      "mechanism"
    ],
    "optional_pack_part_ids": [
      "eco_upgrade_parts"
    ],
    "target_per_part": 20,
    "household_traverse": {
      "next_member_key": "SPACE",
      "next_member_chord": ["SPACE"],
      "min_members": 1,
      "sanity_max_members": 100,
      "member_count_source": "operator_or_agent_observed_portrait_count",
      "member_count_note": "Pass exact observed Live household portrait count as --members N. Host does not invent size.",
      "select_before_dispatch": true,
      "stock_each_member_independently": true
    },
    "cert": {
      "schema": "betterinstincts.diy-parts-budget.cert/v1",
      "states": ["UNKNOWN", "SHORT", "MET"],
      "aggregate_states": [
        "UNPROVEN",
        "PARTIAL",
        "ALL_MEMBERS_MET_REVIEW_REQUIRED"
      ],
      "proof_ceiling": "HOST_DIY_PARTS_BUDGET_CERT_REVIEW_REQUIRED_NOT_BI002",
      "storage_dir": "dist/diy-parts-budget",
      "note": "MET requires independently observed pocket counts ≥ target for every diy_kit part on every member. Plans alone never certify."
    }
  },
  "how_to_buy": {
    "robot_salvage_parts": {
      "summary": "Phone or computer → Order → Purchase Upgrade Parts → Robot Salvage Parts (Sim pocket).",
      "steps": [
        "Select the Sim who needs the parts.",
        "Open phone or click any computer/laptop.",
        "Choose Order.",
        "Choose Purchase Upgrade Parts.",
        "Select Robot Salvage Parts and confirm purchase.",
        "Repeat for each additional unit; parts land in personal inventory immediately."
      ],
      "lab_bulk_alternative": "With testingcheats enabled, Shift+click Dr. F's Official Robotics Workstation → Spawn Crafting Supplies (~50 of each robotics / common upgrade material).",
      "not_this": [
        "Build/Buy catalog search as the primary stock path",
        "Hallucinated objects.gsi_create_obj hex",
        "Household Inventory deposit (these are pocket crafting materials)"
      ]
    }
  },
  "paths": {
