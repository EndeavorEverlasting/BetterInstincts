        {"op": "REQUIRE_MODE", "mode": "LIVE", "fail": "SPAWN_REQUIRES_LIVE"},
        {"op": "REQUIRE_ACTIVE_SIM_SELECTION"},
        {"op": "OPEN_CONSOLE", "chord": ["CTRL", "SHIFT", "C"]},
        {"op": "TYPE_COMMAND", "command": "testingcheats enabled true"},
        {"op": "OPTIONAL_CLOSE_CONSOLE", "key": "ESCAPE"},
        {"op": "OBSERVE", "cue": "robotics_workstation_on_lot", "fail": "WORKSTATION_NOT_OBSERVED"},
        {"op": "SHIFT_CLICK_OBJECT", "target": "robotics_workstation", "fail": "WORKSTATION_SHIFT_CLICK_MISS"},
        {"op": "PIE_MENU", "choice": "Spawn Crafting Supplies", "fail": "SPAWN_SUPPLIES_MISSING"},
        {"op": "OBSERVE", "cue": "crafting_supplies_in_sim_inventory", "fail": "SUPPLIES_NOT_IN_INVENTORY"}
      ]
    },
    "phone": {
      "id": "phone_order_purchase_upgrade_parts",
      "display_name": "Phone → Order → Purchase Upgrade Parts (spam)",
      "required_mode": "LIVE",
      "destination": "sim_pocket_inventory",
      "mutating_action": "PURCHASE_UPGRADE_PART",
      "requires_testingcheats": false,
      "scalability_rank": 2,
      "funds_note": "Each purchase spends Simoleons; ensure funds or run funds_inject first on disposable lab.",
      "steps_template": [
        {"op": "REQUIRE_MODE", "mode": "LIVE", "fail": "PHONE_PURCHASE_REQUIRES_LIVE"},
        {"op": "REQUIRE_ACTIVE_SIM_SELECTION"},
        {"op": "OPEN_PHONE", "fail": "PHONE_NOT_AVAILABLE"},
        {"op": "PIE_MENU", "choice": "Order", "fail": "ORDER_MENU_MISSING"},
        {"op": "PIE_MENU", "choice": "Purchase Upgrade Parts", "fail": "PURCHASE_UPGRADE_PARTS_MISSING"},
        {"op": "SELECT_PART", "from_recipe_field": "display_name", "fail": "PART_ROW_MISSING"},
        {"op": "CONFIRM_PURCHASE"},
        {"op": "OBSERVE", "cue": "part_in_sim_inventory", "fail": "PART_NOT_IN_INVENTORY"},
        {"op": "REPEAT_PURCHASE", "times_from": "quantity_remaining_after_first"}
      ]
    },
    "computer": {
