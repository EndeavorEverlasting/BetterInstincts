          "choice": "Spawn Crafting Supplies",
          "fail": "SPAWN_SUPPLIES_MISSING"
        },
        {
          "op": "OBSERVE",
          "cue": "crafting_supplies_in_sim_inventory",
          "fail": "SUPPLIES_NOT_IN_INVENTORY"
