        "Hardcoded field XY or assumed menu depth",
        "Automatic screen control on boot",
        "Unverified phone Order as the observed route",
        "Blind retries, Bluetooth/driver/service changes",
        "EA Connect",
        "Household Inventory deposit"
      ]
