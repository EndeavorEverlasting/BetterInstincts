{
  "schema": "betterinstincts.player-presence/v1",
  "version": 1,
  "glossary": "contracts/glossary.v1.json",
  "proof_ceiling": "PRESENCE_PROBE_NOT_INPUT_HOOK_OR_LIVE_CERT",
  "states": [
    "PLAYER_PLAYING",
    "HOST_MAY_AUTOMATE",
    "UNKNOWN_PRESENCE"
  ],
  "rules": {
    "PLAYER_PLAYING": {
      "any_of": [
        "operator_declared_playing",
        "player_directed_queue",
        "trusted_global_input_age_below_idle_threshold"
      ],
      "host": "YIELD_TO_PLAYER"
    },
    "HOST_MAY_AUTOMATE": {
      "all_of": [
        "listener_or_automate_session_active",
        "trusted_global_input_age_at_or_above_idle_threshold",
        "probe_succeeded",
        "not_operator_declared_playing",
        "not_player_directed_queue"
      ],
      "host": "EVALUATE_AND_OPTIONAL_EXECUTE"
    },
    "UNKNOWN_PRESENCE": {
      "when": "probe_failed_or_global_input_age_unavailable_or_ambiguous",
      "host": "YIELD_TO_PLAYER"
    }
  },
  "grace_ms_default": 8000,
  "forbidden": [
    "GLOBAL_MOUSE_HOOK_WITHOUT_OPT_IN",
    "BACKGROUND_DAEMON_DEFAULT",
    "SENDINPUT_WHILE_PLAYER_PLAYING",
    "ASSUME_IDLE_FROM_CLOCK_ALONE",
    "TREAT_RESTING_CURSOR_AS_PERMANENT_ACTIVITY",
    "ASSUME_OFF_CANVAS_MEANS_IDLE",
    "EXECUTE_WITH_UNKNOWN_INPUT_AGE"
  ],
  "probe_fields": [
    "foreground_is_sims",
    "cursor_in_client",
    "client_rect",
    "last_input_age_ms",
    "operator_declared_playing",
    "global_input_age_trustworthy"
  ],
  "handoff_contract": "contracts/control-handoff.v1.json",
  "evidence_note": "Foreground/cursor location informs display; only observed global input age and explicit player intent arbitrate screen control. Idle does not imply trusted scene/save."
}
