{
  "schema": "betterinstincts.diy-skill-force/v1",
  "version": 2,
  "authority": "docs/DIY_SKILL_FORCE.md",
  "proof_ceiling": "HOST_SENDINPUT_DIY_SKILL_CHEAT_DISPATCH_NOT_BI005_SKILL_GROWTH_CERT",
  "design_brief": {
    "subject": "Skill-force — max adult Major_* skills on the active Sim/Servo so activities and unlockables are not gated",
    "audience": "operators and Windows host agents who need DIY and other skill unlocks immediately usable",
    "job": "Reusable catalog + mode-agnostic cheat planner: soft-focus → Ctrl+Shift+C → testingcheats enabled true → stats.set_skill_level lines. full_unlock defaults to level 10 across adult majors. Not BI-005 practice_skill growth certification.",
    "architecture": "Sibling to funds_inject / household_object_force. Distinct from read-only sim_profile. No second skill daemon.",
    "operator_correction": "Skill cheats apply to the currently selected Sim; select each household member before execute. Level them all the way (10) so activities/unlockables are not blocked. Missing packs may no-op."
  },
  "activation": {
    "require_explicit_activate": true,
    "never_on_startup": true,
    "never_autorun": true,
    "never_touch_game_speed": true,
    "cli": {
      "catalog": "python -m scripts.diy_skill_force catalog",
      "plan": "python -m scripts.diy_skill_force plan --bundle full_unlock",
      "level": "python -m scripts.diy_skill_force level --bundle full_unlock --execute --process-id PID --session-id ID"
    }
  },
  "inject_sequence": {
    "mode_agnostic": true,
    "allowed_modes": ["live", "build", "buy", "unknown"],
    "require_live_mode": false,
    "never_force_mode_switch": true,
    "open_console_chord": ["CTRL", "SHIFT", "C"],
    "open_console_chord_label": "Ctrl+Shift+C",
    "require_foreground_sims": true,
    "soft_focus_only": true,
    "activate_testing_cheats": "testingcheats enabled true",
    "activate_testing_cheats_alias": "testingcheats true",
    "skill_command_template": "stats.set_skill_level {skill_stat} {level}",
    "default_level": 10,
    "min_level": 1,
    "max_level": 10,
    "close_console_key": "ESCAPE",
    "close_console_optional": true,
    "selection_note": "Commands apply to the currently selected Sim/Servo only.",
    "forbidden": [
      "Resume",
      "Delete",
      "TerminateProcess",
      "edit_save_file",
      "force_F1_while_building",
      "practice_skill",
      "claim_BI005",
      "autorun_on_host_boot"
    ]
  },
