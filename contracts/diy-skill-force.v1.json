{
  "schema": "betterinstincts.diy-skill-force/v1",
  "version": 10,
  "authority": "docs/DIY_SKILL_FORCE.md",
  "proof_ceiling": "HOST_SENDINPUT_DIY_SKILL_CHEAT_DISPATCH_NOT_BI005_SKILL_GROWTH_CERT",
  "design_brief": {
    "subject": "Skill-force — max adult Major_* skills on every household Sim/Servo so activities and unlockables are not gated",
    "audience": "operators and Windows host agents who need DIY and other skill unlocks immediately usable",
    "job": "Reusable catalog + mode-agnostic cheat planner: soft-focus → Ctrl+Shift+C → testingcheats enabled true → stats.set_skill_level lines → bounded ACCEPT_OFFERED_REWARD_TRAIT. full_unlock defaults to level 10. Household mode counts any N members, Space-traverses each, skips skills already recorded complete, Spaces past fully-done members to the next Sim that still needs work, and now runs foreground-only: detached game input cannot verify the current selected portrait. Required residuals Cooking/Fitness/Natural Living re-dispatched at end unless already complete. Not BI-005.",
    "architecture": "Sibling to funds_inject / household_object_force. Distinct from read-only sim_profile and aspiration life-state OK. No second skill/trait daemon. Typing owner: scripts/win32_input.type_text (keybd_event). P100 cohesive household traverse + completion ledger live in this same owner.",
    "operator_correction": "Do not stop at one Sim. N is the observed Live household portrait count — whatever that household is — not an invented ceiling. After a save reload that undoes progression, bootstrap the household with skill-round-robin: one skill for every portrait, then the next skill for every portrait, until all requested skills are level 10. Do not dump every skill onto one Sim before Space. Do not retype skills already maxed on the current Sim. Space between members, skip already-complete skill×member cells, include Cooking/Fitness/Natural Living with correct internal ids (Major_HomestyleCooking, Skill_Fitness, Skill_NLS), and never launch a detached concurrent UI worker; a single foreground owner must attest each portrait and preserve the roster. Do not add Sims/Servos or go online. Opt-in bootstrap entry: python bootstrap.py household-skills -- --members N ... (never autorun on install). Keep Live paused during precious-time dispatch; verify with PLAY_BRIEF → Skills panel LOCAL_OBSERVED → REPAUSE. Console text and LEVEL UP toasts are not PASS. Ledger DISPATCHED is resume/skip evidence only."
  },
  "completion_ledger": {
    "schema": "betterinstincts.diy-skill-force.completion/v1",
    "default_path": "dist/game-host/diy-skill-force-completion.json",
    "keying": "session_id + member_index (or optional member_key label)",
    "statuses": {
      "DISPATCHED": "Host typed stats.set_skill_level at target — resume/skip only; not panel PASS",
      "PANEL_OBSERVED_MAX": "Optional stronger mark after Skills-panel LOCAL_OBSERVED"
    },
    "skip_skill_when": "DISPATCHED only means typed (resume/avoid duplicate commands), not proof of max level; reconcile stale/session/roster state before skipping. PANEL_OBSERVED_MAX requires genuine Skills panel observation.",
    "skip_member_when": "no remaining skills for the requested bundle after ledger filter",
    "space_to_next_needing": true,
    "redo_flag": "--redo ignores ledger for this run",
    "not": [
      "skills_panel_pass",
      "save_mutation",
      "autorun",
      "second_skill_owner"
    ]
  },
  "activation": {
    "require_explicit_activate": true,
    "never_on_startup": true,
    "never_autorun": true,
    "never_leave_sim_speed_running_after_verify": true,
    "never_touch_game_speed_except_bounded_panel_verify": true,
    "cli": {
      "catalog": "python -m scripts.diy_skill_force catalog",
      "plan": "python -m scripts.diy_skill_force plan --bundle full_unlock",
      "level": "python -m scripts.diy_skill_force level --bundle full_unlock --execute --process-id PID --session-id ID",
      "household": "python -m scripts.diy_skill_force household --members N --bundle full_unlock --execute --roster-key PORTRAIT_1 [--roster-key PORTRAIT_2 ...] --first-portrait-attested --process-id PID --session-id ID",
      "bootstrap_household_skills": "python bootstrap.py household-skills -- --members N --bundle full_unlock --execute --roster-key PORTRAIT_1 [--roster-key PORTRAIT_2 ...] --first-portrait-attested --process-id PID --session-id ID"
    }
  },
  "required_residual_skills": [
    "cooking",
    "fitness",
    "natural_living"
  ],
  "household_traverse": {
    "next_member_key": "SPACE",
    "next_member_chord": [
      "SPACE"
    ],
    "ui_chrome_hotkey_id": "SELECT_NEXT_HOUSEHOLD_SIM",
    "min_members": 1,
    "sanity_max_members": 100,
    "max_members": 100,
    "member_count_source": "operator_or_agent_observed_portrait_count",
    "member_count_note": "Pass exact observed Live household portrait count as --members N. N is whatever that household is. Host does not invent size and does not treat 8 or 10 as the product ceiling — sanity_max_members is anti-runaway only. Only one foreground executor controls Space-traverse. Reobserve exact ordered portrait identity after any roster change; stop and reconcile, never silently expand.",
    "dispatch_order": "skill_round_robin",
    "dispatch_order_note": "For each skill in catalog/bundle order: visit every portrait (Space), set that one skill to target, then advance to the next skill. Fairer after save-reload than member_then_skills (all skills on one Sim before Space).",
    "select_before_dispatch": true,
    "close_console_before_space": true,
    "bootstrap_cli": "python bootstrap.py household-skills -- --members N --bundle full_unlock --execute --roster-key PORTRAIT_1 [--roster-key PORTRAIT_2 ...] --first-portrait-attested --process-id PID --session-id ID",
    "console_lifecycle": "Each cell closes the console; do NOT toggle console again before Space. Reopen only inside the next admitted cell.",
    "selected_member_validation": "First portrait locally attested before run; exact roster stable and fresh per cell in local game host; offline policy cannot by itself prove real UI identity.",
    "async_detach_supported": false
  },
  "inject_sequence": {
    "mode_agnostic": true,
    "allowed_modes": [
      "live",
      "build",
      "buy",
      "unknown"
    ],
    "require_live_mode": false,
    "never_force_mode_switch": true,
    "open_console_chord": [
      "CTRL",
      "SHIFT",
      "C"
    ],
    "open_console_chord_label": "Ctrl+Shift+C",
    "require_foreground_sims": true,
    "soft_focus_only": true,
    "activate_testing_cheats": "testingcheats enabled true",
    "activate_testing_cheats_alias": "testingcheats true",
    "skill_command_template": "stats.set_skill_level {skill_stat} {level}",
    "default_level": 10,
    "min_level": 1,
    "max_level": 10,
    "close_console_key": "CTRL_SHIFT_C_TOGGLE",
    "close_console_key_legacy_escape": "ESCAPE",
    "close_console_note": "Prefer Ctrl+Shift+C toggle. Escape while Live often opens pause MENU and breaks Space household traverse.",
    "close_console_optional": true,
    "open_console_chord_owner": "scripts.win32_input.send_key_chord",
    "open_console_chord_note": "Use send_key_chord so CTRL+SHIFT stay held for C. Manual send_vk/tap sequences can drop SHIFT and fire bare C (screenshot) instead of the console.",
    "cheat_line_submit": "type_text_embedded_newline_keybd_event",
    "cheat_line_submit_note": "computer_type newlines do not submit Sims cheat lines. Durable host: re-click console strip then type_text(cmd + '\\n') so Enter is keybd_event inside the typing owner.",
    "pass_requires_skills_panel_local_observed": true,
    "console_text_is_not_pass": true,
    "level_up_toast_is_not_pass": true,
    "selection_note": "Commands apply to the currently selected Sim/Servo only.",
    "typing_owner": "scripts/win32_input.type_text",
    "typing_note": "Prefer keybd_event VkKeyScan typing; KEYEVENTF_UNICODE alone is a silent miss on some TS4 DirectInput hosts.",
    "reward_dialog_accept": {
      "enabled_by_default": true,
      "step": "ACCEPT_OFFERED_REWARD_TRAIT",
      "purpose": "Confirm offered skill-mastery / reward-trait OK dialogs during skill force so unlockables are not left modal-blocked",
      "primary_confirm_key": "ENTER",
      "never_press_cancel": true,
      "interleave_every_n_skill_commands": 5,
      "max_accept_rounds_per_batch": 3,
      "ok_click_client_fractions": [
        [
          0.5,
          0.72
        ],
        [
          0.55,
          0.78
        ]
      ],
      "not": [
        "aspiration_life_state_completion",
        "invite_over_OK",
        "CAS_quiz_Okay",
        "purchase_confirmation"
      ],
      "dialog_identity_required_before_input": true,
      "uncategorized_default": "NEEDS_DIALOG_IDENTIFICATION",
      "legacy_blind_enter_and_coordinate_clicks": "FORBIDDEN"
    },
    "skills_panel_observation": {
      "step": "PLAY_BRIEF_OBSERVE_REPAUSE",
      "paused_panel_status": "UNPROVEN_STALE",
      "paused_panel_note": "Skills UI does not reliably refresh while Live is PAUSED; do not treat a paused-only screenshot as residual-skill failure or as max-level proof.",
      "dispatch_default": "KEEP_PAUSED",
      "verify_default": "PLAY_BRIEF_OBSERVE_REPAUSE",
      "precious_time_triggers": [
        "concurrent_live_cert",
        "main_goal_unfinished",
        "operator_holds_pause",
        "time_is_precious"
      ],
      "keep_paused_policy": "During precious-time / unfinished main-goal work, keep Live paused for skill cheat dispatch and long idle. Do not leave 1x/2x/3x running.",
      "play_brief_for_fresh_panel": {
        "enabled_by_default_for_verify": true,
        "requires_skills_panel_open": true,
        "min_play_seconds": 5,
        "max_play_seconds": 10,
        "default_play_seconds": 7,
        "play_key": "1",
        "pause_key": "0",
        "purpose": "Bounded Live tick so Skills panel refreshes; capture/analyze; immediately re-pause",
        "always_repause": true,
        "not": [
          "leave_sim_running",
          "main_menu_Resume",
          "permanent_speed_change",
          "live_cert_proof",
          "unbounded_unpause"
        ]
      },
      "dispatch_while_paused_allowed": true
    },
    "forbidden": [
      "Resume",
      "Delete",
      "TerminateProcess",
      "edit_save_file",
      "force_F1_while_building",
      "practice_skill",
      "claim_BI005",
      "autorun_on_host_boot",
      "press_Cancel_on_reward_trait",
      "auto_accept_invite_dialogs",
      "leave_sim_speed_running_after_panel_verify",
      "treat_paused_skills_panel_as_fresh_proof",
      "claim_pass_from_console_text",
      "claim_pass_from_level_up_toast",
      "claim_pass_without_skills_panel_local_observed"
    ]
  },
