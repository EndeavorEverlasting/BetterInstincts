{
  "schema": "betterinstincts.installation-profiles-catalog/v1",
  "purpose": "Typed, instance-local user preferences only; not a game input permit, game patch compatibility profile, Sim personality or installer manifest.",
  "storage": "Windows LOCALAPPDATA/BetterInstincts/settings.v1.json; Linux XDG_CONFIG_HOME/betterinstincts/settings.v1.json (or ~/.config/betterinstincts)",
  "defaults": {
    "ui.show_advanced_settings": false,
    "ui.show_evidence_details": true,
    "learning.hover_observations": false,
    "learning.hotkey_observations": false,
    "learning.cheat_observations": false,
    "learning.lot_floor_map_auto": true,
    "learning.build_placement_auto_map": true,
    "automation.cooperative_screen_queue": false,
    "automation.host_suggestions": false,
    "privacy.local_evaluation_receipts": false,
    "learning.semantic_vae": false
  },
  "launch_options": {
    "mode": {
      "label": "Startup mode",
      "control": "choice",
      "default": "production",
      "choices": ["production", "dev"],
      "labels": ["Production — newest save", "Developer — oldest authorized lab save"]
    },
    "idle_ms": {
      "label": "Wait for inactivity",
      "control": "slider",
      "default": 15000,
      "choices": [15000, 21000, 34000, 55000, 89000, 120000],
      "labels": ["15 seconds", "21 seconds", "34 seconds", "55 seconds", "89 seconds", "120 seconds"]
    },
    "allow_cheats": {
      "label": "Allow BetterInstincts to run cheat commands",
      "control": "toggle",
      "default": false
    },
    "household_skill": {
      "label": "Household skill to max with cheats",
      "control": "choice",
      "default": "none",
      "choices": [
        "none", "acting", "apothecary", "archaeology", "baking", "charisma",
        "comedy", "cooking", "dancing", "dj_mixing", "equestrian", "fabrication",
        "fishing", "fitness", "flower_arranging", "gardening", "gourmet_cooking", "guitar",
        "handiness", "herbalism", "logic", "media_production", "mischief", "mixology",
        "natural_living", "nectar_making", "painting", "parenting", "pet_training", "photography",
        "piano", "pipe_organ", "programming", "research_debate", "robotics", "rock_climbing",
        "rocket_science", "selvadoradian_culture", "singing", "skiing", "snowboarding", "vampire_lore",
        "veterinary", "video_gaming", "violin", "wellness", "writing"
      ],
      "labels": [
        "None", "Acting", "Apothecary", "Archaeology", "Baking", "Charisma",
        "Comedy", "Cooking", "Dancing", "DJ Mixing", "Equestrian", "Fabrication",
        "Fishing", "Fitness", "Flower Arranging", "Gardening", "Gourmet Cooking", "Guitar",
        "Handiness", "Herbalism", "Logic", "Media Production", "Mischief", "Mixology",
        "Natural Living", "Nectar Making", "Painting", "Parenting", "Pet Training", "Photography",
        "Piano", "Pipe Organ", "Programming", "Research & Debate", "Robotics", "Rock Climbing",
        "Rocket Science", "Selvadoradian Culture", "Singing", "Skiing", "Snowboarding", "Vampire Lore",
        "Veterinary", "Video Gaming", "Violin", "Wellness", "Writing"
      ]
    }
  },
  "bounds": {
    "max_profiles": 16,
    "max_file_bytes": 32768,
    "profile_id_pattern": "^[a-z][a-z0-9_-]{0,31}$"
  },
  "invariants": [
    "Read-only defaults never create or mutate state",
    "Toggles are preferences consumed only by explicitly integrated adapters; defaults never grant control authority",
    "Mandatory hard safety (save/presence/scene/15s idle/consent) cannot be turned off",
    "No network, global hooks, telemetry, game saves, silent services, or workstation settings",
    "Settings survive installer uninstall; uninstall never deletes user preferences",
    "One writer via exclusive lock, bounded validated JSON, atomic replacement; bad files fail closed",
    "Semantic VAE training is opt-in, on-device, bounded to attested semantic patches; installing/cloning never activates sampling or remote upload"
  ],
  "proof_ceiling": "CONFIGURATION_FUNCTIONALITY_OFFLINE_ONLY",
  "preferred_households": {
    "field": "preferred_households",
    "shape": "Optional map of existing profile IDs to opaque household IDs",
    "write": "Explicit player choice through scripts.instance_settings choose-household",
    "effect_authority": "NONE"
  }
}
