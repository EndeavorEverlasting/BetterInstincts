  "placement_mechanics": {
    "countertops": {
      "id": "COUNTERTOP_PLACEMENT",
      "catalog_tray": {
        "build_mode_path": ["Surfaces", "Cabinets and Counters"],
        "comfort_barstools_path": ["Comfort", "Barstools"]
      },
      "kinds": {
        "standard_counter": {
          "overhang": false,
          "seating_snap": false,
          "affords": ["food_prep", "sink", "small_appliance"],
          "forbidden": ["barstool_snap", "dining_chair_snap"]
        },
        "island_counter": {
          "overhang": true,
          "seating_snap": true,
          "seating_type_required": "barstool",
          "snap_edge": "overhang",
          "affords": ["food_prep", "cooktop_integration", "barstool_seating"],
          "forbidden": ["dining_chair_snap"]
        }
      },
      "shape_tools": {
        "auto_counters_gear": {
          "ui": "Gear icon (Auto-Counters) on the left of the color palette after selecting a counter swatch",
          "job": "Opens custom shapes for that counter set, including island pieces and corner pieces"
        },
        "corner_snap": {
          "job": "Adjacent island/counter tiles snap into L/U configurations when corners meet on the grid"
        }
      },
      "seating_rules": [
        {
          "id": "BARSTOOL_ONLY_ON_ISLAND",
          "when": {"counter_kind": "island_counter", "seating_kind": "barstool"},
          "verdict": "ALLOW_SNAP",
          "reason": "Barstools snap to the island overhang edge"
        },
        {
          "id": "BARSTOOL_ON_STANDARD_DENIED",
          "when": {"counter_kind": "standard_counter", "seating_kind": "barstool"},
          "verdict": "DENY_SNAP",
          "reason": "Standard counters have no overhang for legroom"
        },
        {
          "id": "DINING_CHAIR_NEVER_SNAPS",
          "when": {"seating_kind": "dining_chair"},
          "verdict": "DENY_SNAP",
          "reason": "Only barstools attach to counters; dining chairs never snap"
        },
        {
          "id": "UNKNOWN_KIND_FAIL_CLOSED",
          "when": {"counter_kind": "unknown"},
          "verdict": "DENY_SNAP",
          "reason": "Unknown counter kind fails closed"
        }
      ],
      "env_cap": 2,
      "unlock_cheats": {
        "requires_testingcheats": true,
        "activate_testingcheats": "testingcheats true",
        "ignore_gameplay_unlocks": "bb.ignoregameplayunlocksentitlement",
        "note": "Removes Culinary career padlocks so Corporate Chic island can be placed without career progress"
      },
      "setup_call_stack": [
        "ENTER_BUILD_OR_BUY",
        "OPEN_SURFACES_CABINETS_AND_COUNTERS",
        "SELECT_ISLAND_COUNTER_OR_GEAR_SHAPE",
        "PLACE_ISLAND_ON_GRID",
        "OPEN_COMFORT_BARSTOOLS",
        "DRAG_BARSTOOL_TO_OVERHANG_UNTIL_SNAP",
        "CAPTURE_PROOF"
      ],
      "yield_default_islands_without_cheat": [
        "counter_island.harbinger",
        "counter_island.real_flat",
        "counter_island.immemorial"
      ],
      "career_locked_env_max": [
        "counter.corporate_chic",
        "counter_island.corporate_chic"
      ]
    }
  },
