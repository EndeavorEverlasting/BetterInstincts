{
  "schema": "betterinstincts.camera-traverse/v1",
  "title": "Camera-safe host traversal",
  "architecture": {
    "selected": "CAMERA_SAFE_TRAVERSE",
    "rejected": [
      "EDGE_MOUSE_PARK_WHILE_DEVELOPING",
      "CONTINUOUS_EDGE_HOLD_FOR_SCAN",
      "CLONE_EXTERNAL_VLM_INTO_REPO",
      "DESKTOP_SCREENSHOT_INSTEAD_OF_PRINTWINDOW"
    ],
    "rationale": "Agents must not gather lot data by holding the mouse in the screen-edge pan band and then leave it there while coding. Host owns bounded camera steps that always end at SAFE_CURSOR_REST; PrintWindow capture + lot-model observe are preferred over edge scrolling."
  },
  "defaults": {
    "edge_band_px": 48,
    "max_pan_steps": 8,
    "prefer_capture_first": true,
    "client_width": 1920,
    "client_height": 1080,
    "pan_pixels": 240,
    "safe_rest_inset_ratio": 0.5,
    "post_input_safe_rest": true,
    "post_input_safe_rest_note": "Host-controlled click (including legitimate edge HUD clicks), wheel, and drag must end in SAFE_CURSOR_REST after release; never move player-owned cursor."
  },
  "practices": {
    "CAPTURE_ONLY": {
      "verdict": "GOOD_BEHAVIOR",
      "disposition": "EMULATE",
      "note": "PrintWindow observe without moving camera or parking edge."
    },
    "RIGHT_DRAG_BOUNDED": {
      "verdict": "GOOD_BEHAVIOR",
      "disposition": "EMULATE",
      "note": "Bounded right-drag pan from interior point; must end with SAFE_REST."
    },
    "WHEEL_ZOOM_BOUNDED": {
      "verdict": "GOOD_BEHAVIOR",
      "disposition": "EMULATE",
      "note": "Wheel zoom at interior point; must end with SAFE_REST."
    },
    "SAFE_CURSOR_REST": {
      "verdict": "GOOD_BEHAVIOR",
      "disposition": "EMULATE",
      "note": "Mandatory terminal park outside the edge band after any camera step."
    },
    "EDGE_MOUSE_PARK": {
      "verdict": "BAD_BEHAVIOR",
      "disposition": "OPTIMIZE",
      "note": "Bad agent-owned idle dwell in potential edge-pan band; a momentary verified UI click is NOT EDGE_MOUSE_PARK."
    },
    "CONTINUOUS_EDGE_HOLD": {
      "verdict": "BAD_BEHAVIOR",
      "disposition": "OPTIMIZE",
      "note": "Holding edge scroll to scan while planning/coding."
    },
    "IN_FRAME_WALK_THRASH": {
      "verdict": "BAD_BEHAVIOR",
      "disposition": "OPTIMIZE",
      "note": "Do not substitute Sim walking for camera/lot travel."
    },
    "EDGE_UI_CLICK_TRANSIENT": {
      "verdict": "GOOD_BEHAVIOR",
      "disposition": "EMULATE",
      "note": "Freshly attested one-shot HUD/control click inside pan-guard band, followed immediately by safe interior park; separate host admission mandatory."
    }
  },
  "step_kinds": [
    "CAPTURE_OBSERVE",
    "RIGHT_DRAG_PAN",
    "WHEEL_ZOOM",
    "SAFE_REST"
  ],
  "directions": {
    "N": [
      0,
      -1
    ],
    "S": [
      0,
      1
    ],
    "E": [
      1,
      0
    ],
    "W": [
      -1,
      0
    ],
    "NE": [
      1,
      -1
    ],
    "NW": [
      -1,
      -1
    ],
    "SE": [
      1,
      1
    ],
    "SW": [
      -1,
      1
    ]
  },
  "gates": [
    "CAMERA_SAFE_REST",
    "CAMERA_SAFE_TRAVERSE",
    "CAPTURE_BEFORE_EDGE_SCAN"
  ],
  "forbidden": [
    "EDGE_MOUSE_PARK",
    "CONTINUOUS_EDGE_HOLD",
    "LEAVE_CURSOR_IN_EDGE_BAND",
    "PLAN_WITHOUT_TERMINAL_SAFE_REST",
    "VISION_INVENT_SCENE_FROM_PLANNER",
    "RESUME",
    "DELETE_SAVE",
    "TOUCH_USER_SAVE",
    "BACKGROUND_CAMERA_DAEMON",
    "BLIND_WORLD_CLICK",
    "AUTO_RECLICK",
    "REUSE_PRE_PAN_TARGET_COORDINATES",
    "UNBOUNDED_TARGET_REFRAME",
    "AGENT_CHOOSES_CAMERA_VIEW",
    "UNBOUNDED_CAMERA_PAN",
    "MAP_TRAVERSE_WITHOUT_NAMED_GOAL",
    "LEAVE_CAMERA_ON_STREET",
    "FORGET_RESTORE_AFTER_MAP_LEASE",
    "AGENT_DEFAULT_FULL_ZOOM_OUT",
    "STREET_TOPDOWN_AS_DEFAULT",
    "TRAVEL_AFAR_WITHOUT_LONG_DISTANCE_GOAL",
    "ENVIRONMENT_NAV_WITHOUT_PLANNING_GOAL",
    "CLAIM_SKILL_MAX_FROM_DISPATCHED_ONLY",
    "RIGHT_CLICK_AS_ZOOM_ACTUATOR",
    "STREET_TOPDOWN_OBJECT_IDENTIFY",
    "IDENTIFY_WORLD_OBJECT_FROM_ZOOMED_OUT_CAPTURE"
  ],
  "zoom_controls": {
    "owner": "contracts/ui-chrome.v1.json#modes.LIVE.hotkeys",
    "semantic_split": "ZOOM_MODE_IS_NOT_ZOOM_CONTROL",
    "operator_correction_20261110": "Zooming in is not a right-click. Zooming in is a hotkey (Z). X zooms out. Scroll wheel also zooms.",
    "preferred_channel": "KEY",
    "controls": {
      "CAMERA_ZOOM_IN": {
        "hotkey_id": "CAMERA_ZOOM_IN",
        "chord": ["Z"],
        "wheel": "SCROLL_WHEEL_ZOOM_IN",
        "helper": "scripts.win32_input.send_key_chord|send_wheel"
      },
      "CAMERA_ZOOM_OUT": {
        "hotkey_id": "CAMERA_ZOOM_OUT",
        "chord": ["X"],
        "wheel": "SCROLL_WHEEL_ZOOM_OUT",
        "helper": "scripts.win32_input.send_key_chord|send_wheel"
      }
    },
    "not_zoom_controls": [
      "RIGHT_CLICK",
      "PORTRAIT_RMB",
      "RIGHT_CLICK_VIEW",
      "ENTER",
      "SHIFT_ENTER"
    ],
    "right_click_view_note": "RIGHT_CLICK_VIEW names a zoom-ladder mode (0.85 of max close) plus portrait-follow posture. Achieving that distance uses CAMERA_ZOOM_IN / wheel — never RMB as the zoom actuator."
  },
  "object_pick_identify": {
    "id": "OBJECT_PICK_IDENTIFY",
    "owner": "betterinstincts/camera_traverse.py",
    "when": "WORLD_OBJECT_PICK_OR_INTERACT",
    "not_when": [
      "LEAN_SKILL_FORCE_TYPING",
      "FIXED_UI_CHROME_CLICK"
    ],
    "steps": [
      "REQUIRE_NAMED_WORLD_OBJECT_GOAL",
      "LEAVE_TRAVEL_AFAR_IF_OBSERVED",
      "BOUNDED_TRAVERSE_OR_CENTER_ACTIVE_SIM",
      "ZOOM_IN_VIA_CAMERA_ZOOM_IN_OR_WHEEL",
      "PRINTWINDOW_OR_HOST_CAPTURE_AT_CURRENT_CAMERA_REVISION",
      "IDENTIFY_OBJECT_FROM_ZOOMED_CAPTURE",
      "CLICK_ONLY_AFTER_IDENTIFY",
      "SAFE_CURSOR_REST"
    ],
    "zoom_actuator": ["CAMERA_ZOOM_IN", "SCROLL_WHEEL_ZOOM_IN"],
    "forbidden_zoom_actuator": ["RIGHT_CLICK", "PORTRAIT_RMB"],
    "identify_requires": "ZOOMED_IN_CAPTURE_SAME_CAMERA_REVISION",
    "planner": "plan_object_pick_identify",
    "cli": "python -m scripts.camera_traverse object-pick-plan --target-id ID",
    "proof_ceiling": "OFFLINE_OBJECT_PICK_IDENTIFY_PLAN_NOT_LIVE_OBJECT_CLICK_CERT"
  },
  "room_map_traverse": {
    "id": "ROOM_MAP_TRAVERSE",
    "owner": "betterinstincts/room_map_traverse.py",
    "when": "NAMED_MAP_LEASE_ROOM_OBJECT_SEARCH",
    "operator_correction_20261110": "Default centers on active Sim; rare named map lease may leave Sim. Preferred census: Build (F3) → T top-down → room-fit BUILD_TOP_DOWN_MAP zoom (operator-centered; do not re-zoom once attested) → Select-click one item → read bottom-right params → document name+client_xy → Escape → next. Needs-investigation opportunistic map remains preferred when Live. Offline only — no Gallery/EA Connect. If grabbed/held: ESCAPE immediately (never place/sell/inventory). Do not pan/zoom away from the operator-centered frame during census.",
    "parallel_with": [
      "active_sim_camera_lock",
      "object_pick_identify",
      "lot_floor_map",
      "build_library_checkpoint",
      "agent_zoom_policy"
    ],
    "primary_census": "BUILD_TOP_DOWN_T",
    "zoom_mode_target": "BUILD_TOP_DOWN_MAP",
    "build_entry": {
      "hotkey_id": "MODE_BUILD",
      "chord": ["F3"],
      "top_down_hotkey_id": "CAMERA_BUILD_TOP_DOWN",
      "top_down_chord": ["T"],
      "zoom_out": ["X", "SCROLL_WHEEL_ZOOM_OUT"],
      "once_room_fit": "PRESERVE_OPERATOR_FRAME_NO_FURTHER_ZOOM",
      "status": "OPERATOR_OBSERVED_20261110"
    },
    "map_lease_ms_max": 30000,
    "max_pan_steps": 8,
    "observe_only": true,
    "census_inspect": {
      "id": "BUILD_SELECT_INSPECT_ESCAPE",
      "loop": [
        "ENSURE_SELECT_TOOL",
        "LMB_CLICK_ONE_OBJECT",
        "READ_BOTTOM_RIGHT_PARAMS",
        "DOCUMENT_CATALOG_NAME_AND_CLIENT_XY",
        "ESCAPE",
        "NEXT_OBJECT"
      ],
      "capture": "PRINTWINDOW_NOT_DESKTOP_SCREENSHOT",
      "preserve_camera": true,
      "forbid_after_room_fit": ["X", "Z", "SCROLL_WHEEL_ZOOM", "PAN", "MIDDLE_DRAG", "EDGE_PAN"]
    },
    "input_policy": {
      "preferred_channel": "SELECT_INSPECT_THEN_ESCAPE",
      "camera_and_mode": ["F3", "T", "X", "Z", "F1", "ESCAPE", "SCROLL_WHEEL_AT_SAFE_INTERIOR_ONLY"],
      "allow_during_census": ["LMB_SELECT_INSPECT", "ESCAPE", "SELECT_TOOL_HOTKEY"],
      "forbid_during_census": [
        "LMB_DRAG_MOVE",
        "RMB_WORLD_OBJECT",
        "DRAG_OBJECT",
        "CATALOG_PURCHASE",
        "SLEDGEHAMMER",
        "EYEDROPPER_APPLY",
        "GALLERY",
        "PAN_OR_REZOOM_AFTER_ROOM_FIT"
      ],
      "note": "Operator 2026-11-10 (revised): Select-click → bottom-right params → document → Escape is the safe cohesive census. Preserve centered room-fit zoom. Escape on grab/hold."
    },
    "on_erroneous_grab": {
      "detect": ["OBJECT_HELD", "OBJECT_SELECTED_FOR_MOVE", "PLACE_SELL_INVENTORY_STRIP", "CANCEL_ESC_STRIP"],
      "action": ["ESCAPE", "ESCAPE_AGAIN_IF_STILL_HELD", "RESUME_SELECT_INSPECT_ESCAPE_MAPPING"],
      "forbidden_followups": ["PLACE", "SELL", "PLACE_IN_INVENTORY", "ROTATE_IN_PLACE", "CLICK_WORLD_TO_DESELECT", "CTRL_Z_AS_FIRST_CHOICE_WHEN_ESCAPE_SUFFICES"]
    },
    "default_seed_landmarks": [
      "LANDMARK_DINING_TABLE",
      "LANDMARK_RUG_CLUSTER"
    ],
    "default_adjacency_note": "Corner: overlapping rugs + dinner table → robotics workbench",
    "steps": [
      "REQUIRE_NAMED_MAP_GOAL",
      "LOAD_MEMORIALIZED_GRAPH",
      "DISMISS_BLOCKING_OVERLAY",
      "ENTER_BUILD_OBSERVE_ONLY",
      "CAMERA_BUILD_TOP_DOWN_T",
      "ATTEST_OR_REACH_BUILD_TOP_DOWN_MAP_ROOM_FIT",
      "PRESERVE_OPERATOR_CENTERED_FRAME",
      "CLOSE_CATALOG_WITH_ESCAPE_IF_OBSCURING_PARAMS",
      "SELECT_CLICK_INSPECT_LOOP",
      "UPSERT_GRAPH_NODES_EDGES",
      "MEMORIALIZE_NEW_MAPPED_ITEMS",
      "ON_ERRONEOUS_GRAB_ESCAPE_AND_RESUME",
      "OPTIONAL_LOCAL_LIBRARY_SAVE_FOLDER_ONLY_NO_GALLERY",
      "EXIT_BUILD_F1_RESTORE_LIVE",
      "SAFE_CURSOR_REST",
      "AT_INTERACT_TIME_ASSESS_EXPECTED_INTERACTIONS",
      "IF_EXPECTED_MISSING_INVALIDATE_AND_REMAP_NODE"
    ],
    "forbidden": [
      "UNBOUNDED_CAMERA_PAN",
      "LEAVE_CAMERA_ON_STREET",
      "MAP_TRAVERSE_WITHOUT_NAMED_GOAL",
      "FORGET_RESTORE_AFTER_MAP_LEASE",
      "EDGE_MOUSE_PARK",
      "REZOOM_OR_PAN_AWAY_FROM_OPERATOR_CENTERED_ROOM_FIT",
      "MUTATE_LOT_WHILE_MAPPING",
      "GRAB_MOVE_PLACE_SELL_OR_INVENTORY_DURING_CENSUS",
      "CONTINUE_AFTER_GRAB_WITHOUT_ESCAPE",
      "LMB_DRAG_OR_PURCHASE_DURING_MAP_CENSUS",
      "MOUSE_DESELECT_INSTEAD_OF_ESCAPE",
      "GALLERY_SHARE_OR_EA_CONNECT",
      "ONLINE_FEATURES",
      "ARBITRARY_LIVE_PERSPECTIVE_CLICK_AS_GRAPH_AUTHORITY"
    ],
    "planner": "plan_room_map_traverse",
    "cli": "python -m scripts.lot_floor_map room-traverse-plan --goal-id ID --target-kind ROBOTICS_WORKSTATION",
    "proof_ceiling": "OFFLINE_ROOM_MAP_TRAVERSE_PLAN_PLUS_LOCAL_GRAPH_STORE_NOT_LIVE_CLICK_CERT"
  },
