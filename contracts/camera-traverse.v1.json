{
  "schema": "betterinstincts.camera-traverse/v1",
  "title": "Camera-safe host traversal",
  "architecture": {
    "selected": "CAMERA_SAFE_TRAVERSE",
    "rejected": [
      "EDGE_MOUSE_PARK_WHILE_DEVELOPING",
      "CONTINUOUS_EDGE_HOLD_FOR_SCAN",
      "CLONE_EXTERNAL_VLM_INTO_REPO",
      "DESKTOP_SCREENSHOT_INSTEAD_OF_PRINTWINDOW"
    ],
    "rationale": "Agents must not gather lot data by holding the mouse in the screen-edge pan band and then leave it there while coding. Host owns bounded camera steps that always end at SAFE_CURSOR_REST; PrintWindow capture + lot-model observe are preferred over edge scrolling."
  },
  "defaults": {
    "edge_band_px": 48,
    "max_pan_steps": 8,
    "prefer_capture_first": true,
    "client_width": 1920,
    "client_height": 1080,
    "pan_pixels": 240,
    "safe_rest_inset_ratio": 0.5,
    "post_input_safe_rest": true,
    "post_input_safe_rest_note": "Host-controlled click (including legitimate edge HUD clicks), wheel, and drag must end in SAFE_CURSOR_REST after release; never move player-owned cursor."
  },
  "practices": {
    "CAPTURE_ONLY": {
      "verdict": "GOOD_BEHAVIOR",
      "disposition": "EMULATE",
      "note": "PrintWindow observe without moving camera or parking edge."
    },
    "RIGHT_DRAG_BOUNDED": {
      "verdict": "GOOD_BEHAVIOR",
      "disposition": "EMULATE",
      "note": "Bounded right-drag pan from interior point; must end with SAFE_REST."
    },
    "WHEEL_ZOOM_BOUNDED": {
      "verdict": "GOOD_BEHAVIOR",
      "disposition": "EMULATE",
      "note": "Wheel zoom at interior point; must end with SAFE_REST."
    },
    "SAFE_CURSOR_REST": {
      "verdict": "GOOD_BEHAVIOR",
      "disposition": "EMULATE",
      "note": "Mandatory terminal park outside the edge band after any camera step."
    },
    "EDGE_MOUSE_PARK": {
      "verdict": "BAD_BEHAVIOR",
      "disposition": "OPTIMIZE",
      "note": "Bad agent-owned idle dwell in potential edge-pan band; a momentary verified UI click is NOT EDGE_MOUSE_PARK."
    },
    "CONTINUOUS_EDGE_HOLD": {
      "verdict": "BAD_BEHAVIOR",
      "disposition": "OPTIMIZE",
      "note": "Holding edge scroll to scan while planning/coding."
    },
    "IN_FRAME_WALK_THRASH": {
      "verdict": "BAD_BEHAVIOR",
      "disposition": "OPTIMIZE",
      "note": "Do not substitute Sim walking for camera/lot travel."
    },
    "EDGE_UI_CLICK_TRANSIENT": {
      "verdict": "GOOD_BEHAVIOR",
      "disposition": "EMULATE",
      "note": "Freshly attested one-shot HUD/control click inside pan-guard band, followed immediately by safe interior park; separate host admission mandatory."
    }
  },
  "step_kinds": [
    "CAPTURE_OBSERVE",
    "RIGHT_DRAG_PAN",
    "WHEEL_ZOOM",
    "SAFE_REST"
  ],
  "directions": {
    "N": [
      0,
      -1
    ],
    "S": [
      0,
      1
    ],
    "E": [
      1,
      0
    ],
    "W": [
      -1,
      0
    ],
    "NE": [
      1,
      -1
    ],
    "NW": [
      -1,
      -1
    ],
    "SE": [
      1,
      1
    ],
    "SW": [
      -1,
      1
    ]
  },
  "gates": [
    "CAMERA_SAFE_REST",
    "CAMERA_SAFE_TRAVERSE",
    "CAPTURE_BEFORE_EDGE_SCAN"
  ],
  "forbidden": [
    "EDGE_MOUSE_PARK",
    "CONTINUOUS_EDGE_HOLD",
    "LEAVE_CURSOR_IN_EDGE_BAND",
    "PLAN_WITHOUT_TERMINAL_SAFE_REST",
    "VISION_INVENT_SCENE_FROM_PLANNER",
    "RESUME",
    "DELETE_SAVE",
    "TOUCH_USER_SAVE",
    "BACKGROUND_CAMERA_DAEMON",
    "BLIND_WORLD_CLICK",
    "AUTO_RECLICK",
    "REUSE_PRE_PAN_TARGET_COORDINATES",
    "UNBOUNDED_TARGET_REFRAME",
    "AGENT_CHOOSES_CAMERA_VIEW",
    "UNBOUNDED_CAMERA_PAN",
    "MAP_TRAVERSE_WITHOUT_NAMED_GOAL",
    "LEAVE_CAMERA_ON_STREET",
    "FORGET_RESTORE_AFTER_MAP_LEASE"
  ],
  "house_state_actions": [
    "CAMERA_PAN_ZOOM",
    "CAPTURE_ONLY",
    "OBSERVE_ONLY"
  ],
  "proof_ceiling": "OFFLINE_CAMERA_SAFE_TRAVERSE_NOT_LIVE_CAMERA_PROOF",
  "owners": {
    "contract": "contracts/camera-traverse.v1.json",
    "library": "betterinstincts/camera_traverse.py",
    "cli": "scripts/camera_traverse.py",
    "docs": "docs/CAMERA_TRAVERSE.md",
    "mouse_primitives": "scripts/win32_input.py",
    "capture": "scripts/game_capture.py",
    "admission": "betterinstincts/screen_admit.py",
    "world_framing_host": "betterinstincts/host_stack.py",
    "active_sim_lock": "betterinstincts/active_sim_camera_lock.py",
    "portrait_follow": "betterinstincts/portrait_follow.py"
  },
  "prior_art": {
    "automation_visual_intelligence": "ADAPT observe≠act seam; do not clone donor CV stacks into BetterInstincts",
    "tokencorridor_visual_incubation": "ADAPT deterministic PrintWindow/luma before optional CV escalation",
    "local_printwindow": "ADOPT existing scripts/game_capture.py as primary see-without-edge-pan sensor"
  },
  "world_target_framing": {
    "camera_before_world_click": true,
    "applies_to": "WORLD_OBJECT_TARGETS_NOT_FIXED_UI_CHROME",
    "interior_margin_px": 48,
    "min_target_extent_px": 44,
    "max_reframe_attempts": 3,
    "required_host_observation": [
      "source:HOST_CAPTURE",
      "target_id",
      "capture_ref",
      "camera_revision",
      "target_visible",
      "occluded",
      "bbox_client_if_visible",
      "framing_attempts"
    ],
    "planner_behavior": "OBSERVE_TARGET_THEN_BOUNDED_CAMERA_REFRAME_THEN_SAFE_REST_THEN_FRESH_REOBSERVATION_THEN_HOST_ADMISSION",
    "coordinates": "CLIENT_RELATIVE_TARGET_BOUNDING_BOX",
    "camera_directions": "HOST_OBSERVED_ONLY_NO_BLIND_GUESS",
    "safety_guards": [
      "NO_WORLD_CLICK_BEFORE_FRAMED",
      "REOBSERVE_AFTER_ANY_CAMERA_MOVE",
      "NO_AUTO_RECLICK",
      "NO_AUTO_PAN_LOOP",
      "PLAYER_PRESENCE_AND_SAVE_ADMISSION_INDEPENDENT"
    ]
  },
  "drift_recovery": {
    "owner": "betterinstincts/camera_traverse.py",
    "goal": "REANCHOR_CAMERA_BEFORE_PIXEL_SAMPLE_OR_WORLD_CLICK",
    "safe_rest_before_pixel_targeting": true,
    "require_camera_revision_at_world_click": true,
    "require_fresh_capture_after_any_camera_move": true,
    "max_camera_reanchor_attempts": 2,
    "step_order": [
      "YIELD_IF_PLAYER_OWNS_SCREEN_OR_INPUT_FIELD",
      "SAFE_REST_WHEN_CURSOR_IN_EDGE_BAND",
      "CAPTURE_NEW_FRAME_AND_CAMERA_REVISION",
      "ENTER_FOR_ACTIVE_SIM_OR_SHIFT_ENTER_FOR_LOT_ONLY_IF_DISPLACED",
      "OPTIONAL_FOLLOW_ONLY_BY_APPROVED_GAME_API_OR_VERIFIED_PORTRAIT_ADAPTER",
      "HOST_OBSERVED_BOUNDED_TRAVERSE_FOR_WORLD_OBJECT",
      "CAPTURE_NEW_FRAME_AND_REDETECT_TARGET",
      "VERIFY_PIXEL_BBOX_AND_CAMERA_REVISION_BEFORE_SINGLE_CLICK"
    ],
    "forbid": [
      "REUSE_WORLD_PIXELS_AFTER_REANCHOR",
      "UNCALIBRATED_PORTRAIT_RIGHT_CLICK",
      "BLIND_EDGE_PAN",
      "UNBOUNDED_CAMERA_RECENTER_LOOP",
      "IGNORE_PLAYER_INTERRUPT",
      "CLICK_WITHOUT_SAME_REVISION_TARGET"
    ],
    "chrome_exemption": "FIXED_HUD_UI_CHROME_NO_CAMERA_REVISION_REQUIRED_BUT_PLAYER_SCREEN_GATES_UNCHANGED",
    "no_auto_execute": true,
    "note": "Recovery is a host decision, not a new global mouse hook. Every physical action still needs the existing exact-PID/session/15-second idle admission and a fresh host observation. No physical game follow proof in cloud.",
    "gameplay_pause": {
      "pause_before_live_pixel_targeting": true,
      "toggle_key": [
        "P"
      ],
      "keyboard_command_owner": "scripts/win32_input.py",
      "evaluator": "betterinstincts/camera_traverse.py:assess_game_pause",
      "host_port": "scripts/camera_traverse.py:pause_game_on_admitted_host",
      "effective_modes": [
        "LIVE"
      ],
      "playing_precondition": "HOST_GAME_CLOCK_AND_HUD_CORROBORATE_PLAYING_ONLY",
      "paused_precondition": "HOST_GAME_CLOCK_AND_HUD_CORROBORATE_PAUSED_ONLY",
      "required_clock_fields": [
        "source",
        "capture_ref",
        "camera_revision",
        "game_version",
        "clock_revision",
        "speed_state",
        "pause_indicator_active",
        "clock_still_during_sample"
      ],
      "never_toggle_if_already_paused": true,
      "auto_resume": false,
      "invalidate_pixels_after_pause": true,
      "gameplay_clock_pause_does_not_freeze_camera": true,
      "paused_live_panel_can_be_stale": true,
      "note": "One-shot P is a toggle; no key on PAUSED/UNKNOWN, never resume automatically. Local host must reobserve speed, exact scene and target after pausing. Skills panel retains separate short-play/re-pause proof owner."
    }
  },
  "active_sim_camera_lock": {
    "owner": "betterinstincts/active_sim_camera_lock.py",
    "default": "FOLLOW_ACTIVE_SIM",
    "center_chord": [
      "ENTER"
    ],
    "not_equivalent": [
      "SHIFT",
      "ENTER"
    ],
    "map_exception": "FRESH_HOST_TASK_GOAL_WITH_NAMED_TARGET",
    "max_lease_ms": 30000,
    "max_pan_steps": 8,
    "required_initial_state": "ACTIVE_SIM_CENTERED_OR_FOLLOWING",
    "terminal_restore": "ADMITTED_ENTER_IN_FINALLY_REOBSERVE",
    "human_interrupt": "YIELD_AND_RESTORE_PENDING",
    "executor": "scripts/camera_traverse.py::_execute_plan",
    "unscoped_cli_execute": "REFUSE_CAMERA_PAN_ZOOM",
    "proof": "OFFLINE_POLICY_AND_INJECTED_PORT_NOT_LIVE_GAMEPLAY",
    "preferred_control": "RIGHT_CLICK_ACTIVE_SIM_PORTRAIT",
    "primary_gate": "FRESH_SELECTED_PORTRAIT_TWO_CUES_AND_EXACT_HITBOX",
    "keyboard_fallback": "ENTER_ONE_SHOT_CENTER_ONLY_NOT_FOLLOW",
    "lot_center_hotkey": "SHIFT_ENTER_NOT_ACTIVE_SIM",
    "already_centered_once": "NOT_FOLLOW_LOCK;PORTRAIT_ATTESTATION_REQUIRED",
    "after_map_restore": "ADMITTED_PORTRAIT_RIGHT_CLICK_PREFERRED;ENTER_ONE_SHOT_IF_PORT_UNAVAILABLE;REOBSERVE_FOLLOW"
  },
  "edge_interaction": {
    "meaning": "CLIENT_RELATIVE_CAMERA_PAN_GUARD_NOT_MONITOR_BEZEL",
    "description": "'Screen edge' means the client-relative region that may trigger Sims camera translation when the pointer lingers; a conservative 48-pixel guard band stands in until exact-build pan activation is measured. HUD controls can overlap this band. A coordinate alone does not establish bad intent.",
    "coordinate_frame": "SIMS_GAME_CLIENT_RECT_NOT_FULL_DESKTOP",
    "calibration": "CONSERVATIVE_AVOIDANCE_MARGIN_NOT_EXACT_ENGINE_TRIGGER",
    "phases": [
      "REST",
      "TARGETED_CLICK",
      "TRANSIT",
      "CAMERA_NAVIGATION"
    ],
    "valid_transient_edge_click": {
      "target_kind": "UI_CHROME",
      "fresh_target_attestation_required": true,
      "one_click_only": true,
      "post_release_safe_rest_required": true,
      "host_input_admission_required": true,
      "may_grant_control_permit": false
    },
    "forbidden": [
      "HOST_OWNED_IDLE_EDGE_DWELL",
      "UNKNOWN_EDGE_TARGET_CLICK",
      "WORLD_OBJECT_EDGE_CLICK_WITHOUT_CAMERA_FRAMING",
      "UNBOUNDED_EDGE_PAN_WHILE_AGENT_REASONING",
      "REPOSITION_PLAYER_OWNED_CURSOR"
    ],
    "frame_revision_policy": "AFTER_ANY_ACTUAL_CAMERA_MOTION_RECAPTURE_AND_REVALIDATE_BEFORE_WORLD_CLICK",
    "host_owner": "betterinstincts/camera_traverse.py",
    "physical_input_owner": "scripts/win32_input.py",
    "proof_ceiling": "OFFLINE_EDGE_POLICY_NOT_LIVE_CAMERA_VERIFICATION"
  }
}
