{
  "schema": "betterinstincts.purchase-dialog/v1",
  "owner": "betterinstincts/purchase_dialog.py",
  "entrypoints": [
    "discover_dialog_page",
    "derive_demand",
    "propose_dialog_cart_step",
    "verify_dialog_purchase",
    "enqueue_dialog_step"
  ],
  "integration_owners": {
    "menu_navigation": "betterinstincts/upgrade_parts_force.py::next_observed_menu_choice",
    "upgrade_parts_picker": "betterinstincts/computer_upgrade_parts.py::propose_computer_batch_step",
    "cooperative_effect_queue": "betterinstincts/workflow_interop.py::CooperativeScreenQueue",
    "game_native_successor": "https://github.com/EndeavorEverlasting/BetterInstincts/issues/171"
  },
  "dynamic_dialog_identity": [
    "menu_id",
    "source",
    "actor_id",
    "revision"
  ],
  "known_evidence_fixtures": [
    {
      "source": "nectar_machine",
      "menu_id": "purchase_basic_ingredients",
      "visible": [
        "Apple",
        "Grape",
        "Lemon",
        "Potato",
        "Strawberry"
      ],
      "more_rows": "UNKNOWN_UNTIL_BOTTOM_OBSERVED"
    },
    {
      "source": "nectar_machine",
      "menu_id": "apothecary_advanced",
      "visible": [
        "Acorn",
        "Aura Petal",
        "Basil",
        "Daisy",
        "Lemon",
        "Lightning Root Leaf",
        "Lump of Moss",
        "Sage",
        "Small Critter Bone"
      ],
      "more_rows": "UNKNOWN_UNTIL_BOTTOM_OBSERVED"
    },
    {
      "source": "computer",
      "menu_id": "oversized_crop_seeds",
      "visible": [
        "Aubergine Seeds",
        "Lettuce Seeds",
        "Mushroom Seeds",
        "Pumpkin Seeds",
        "Watermelon Seeds"
      ],
      "more_rows": "UNKNOWN_UNTIL_BOTTOM_OBSERVED"
    },
    {
      "source": "computer",
      "menu_id": "purchase_medicine",
      "visible": [
        "Medicine"
      ],
      "owned_count_visible": "10 owned in operator screenshot; not universally asserted"
    },
    {
      "source": "computer",
      "menu_id": "purchase_seeds",
      "visible": [],
      "status": "ENTRY_MENU_OBSERVED_NOT_PICKER"
    },
