      "source": "computer",
      "menu_id": "purchase_caterpillar_incubator",
      "visible": [],
      "status": "ENTRY_MENU_OBSERVED_NOT_PICKER"
    },
    {
      "source": "computer",
      "menu_id": "purchase_seasonal_seeds",
      "visible": [],
      "status": "ENTRY_MENU_OBSERVED_NOT_PICKER"
    },
    {
      "source": "computer",
      "menu_id": "purchase_gifts",
      "visible": [],
      "status": "ENTRY_MENU_OBSERVED_NOT_PICKER"
    }
  ],
  "per_actor_scope": "Current observed portrait ID only; actor+menu+source bind every page and cart, no fixed household or Sim slot",
  "scroll_machine": {
    "phases": [
      "SEEK_TOP",
      "SCAN_DOWN",
      "COMPLETE"
    ],
    "bounded_pages": 24,
    "bounded_items": 240,
    "must_verify": [
      "fresh_revision",
      "at_top",
      "at_bottom",
      "current_menu_identity",
      "selected_portrait_identity",
      "observed_visible_rows",
      "price_consistency"
    ],
    "repeated_viewport": "HOLD_DO_NOT_SCROLL",
    "offscreen_target": "MOVE_ONE_VERIFIED_PAGE_TOWARD_CATALOGED_TARGET_THEN_REOBSERVE",
    "mutation_after_scroll": "REQUIRE_FRESH_PAGE_MOVEMENT_READBACK",
    "unknown_bottom": "HOLD_DO_NOT_INFER_FULL_CATALOG"
  },
  "dynamic_trigger_registry": {
    "registry_extension": "Add evidence-backed trigger and its consumer test; do not require new purchase engine per DLC",
    "supported": [
      "career_required_material",
      "garden_missing_seed",
      "garden_missing_ingredient",
      "handiness_upgrade_part",
      "servo_repair_part",
      "fixer_bot_repair_part",
      "apothecary_recipe",
      "nectar_recipe",
      "crafting_recipe",
      "household_restock",
      "explicit_player_purchase"
    ],
    "evidence_required": [
      "trigger kind",
      "actor_id",
      "menu_id",
      "item_id",
      "evidence_ref",
      "required",
      "owned"
    ],
    "demand_semantics": "Buy the positive verified stock gap; a visible item is not itself a purchase trigger."
  },
  "quantity_limits": {
    "per_item": 999,
    "max_unit_price_simoleons": 1000000
  },
  "transaction": {
    "states": [
      "OBSERVE",
      "INCREMENT_ONE",
      "RECONCILE_INCREMENT",
      "SCROLL_ONE_PAGE",
      "RECONCILE_SCROLL",
      "CONFIRM_ONCE",
      "RECONCILE_OUTCOME"
    ],
    "inputs_required": [
      "complete_catalog",
      "fresh_observed_rows",
      "selected_sim_inventory_baseline",
      "observed_total_count",
      "observed_total_cost",
      "observed_funds",
      "approved_spend_cap",
      "explicit_user_command",
      "spending_authorization",
      "player_idle",
      "paused_live",
      "scene_actor_fresh",
      "native_verified_or_explicit_desktop_opt_in"
    ],
    "progress": "One effect proposal per fresh revision. Never click without current hitbox and after-action count+cost readback.",
    "cost_rule": "Requested quantity * observed price, scoped to household funds and explicit cap",
    "success_proof": "Exact selected-Sim item inventory delta and exact household funds debit after one Buy",
    "failure_rule": "Stop, reconcile, never blind retry or re-buy",
    "execute_allowed": false
  },
  "operational_boundary": {
    "native_gameplay_authority": "POLICY_ONLY",
    "game_build": "UNOBSERVED",
    "external_cursor_agent": "NOT_INVOKED",
    "host_game_session": "NOT_AVAILABLE",
    "no_automatic_spending": true,
    "no_native_runtime_claim": true,
    "no_external_clicker": true,
    "player_first": true,
    "save_safe": true,
    "build_buy_excluded_without_existing_library_checkpoint": true
  },
  "proof_ceiling": "OFFLINE_POLICY_CI_ONLY; game P08 requires local exact-patch native/mod+disposable-sim observation and rollback",
  "validation": [
    "python -m unittest tests.test_purchase_dialog -v",
    "python -m scripts.check_native_gameplay_authority",
    "python scripts/semantic_preflight.py"
  ]
}
