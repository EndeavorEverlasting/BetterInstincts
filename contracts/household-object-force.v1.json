    }
  ],
  "call_stack": {
    "success": [
      "PLAYER_FIRST / yield if player_directed",
      "RESOLVE useful_item_catalog rows for requested ids (or all non-optional)",
      "If any row requires_elementary_unlock: OPEN console → testingcheats true → bb.showhiddenobjects (one line per Enter)",
      "For career_promote rows: repeat careers.promote … until observed target_level / branch reward deposits into HOUSEHOLD_INVENTORY; optional demote after claim",
      "For catalog_search rows: enter observed Build/Buy, search attested terms; optional BBB Organized Debug filter only AFTER elementary unlock",
      "Place large objects from HOUSEHOLD_INVENTORY or directly on lot — never PERSONAL_POCKET",
      "Emit receipt with exact commands planned; execute_allowed=false until independent screen_admit"
    ],
    "failure": [
      "skip bb.showhiddenobjects for catalog_search → ELEMENTARY_UNLOCK_REQUIRED",
      "substitute BBB for showhiddenobjects → SUBSTITUTE_BBB_FOR_SHOW_HIDDEN_OBJECTS",
      "emit gsi_create_obj / hex → HALLUCINATED_INSTANCE_HEX_FORBIDDEN",
      "pocket destination for large object → PERSONAL_POCKET_FORBIDDEN"
    ]
  },
  "invariants": [
    "bb_showhiddenobjects_elementary_for_catalog_hidden_list_items",
    "bbb_never_replaces_elementary_unlock",
    "no_hallucinated_gsi_create_obj_hex",
    "large_objects_household_inventory_or_lot_only",
    "one_command_per_line",
    "player_first_yields",
    "library_plans_execute_allowed_false",
    "does_not_close_bi002"
  ]
}
