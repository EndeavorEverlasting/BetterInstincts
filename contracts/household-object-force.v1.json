{
  "schema": "betterinstincts.household-object-force/v1",
  "version": 1,
  "authority": "docs/HOUSEHOLD_OBJECT_FORCE.md",
  "proof_ceiling": "OFFLINE_HOUSEHOLD_OBJECT_FORCE_PLAN_NOT_LIVE_SPAWN_NOT_GSI_CREATE_OBJ_CERT",
  "design_brief": {
    "subject": "Household Object Force — durable useful-item catalog into any household on command",
    "audience": "operators and Windows host agents who need career rewards and hidden fabrication gear without hallucinated hex IDs",
    "job": "Reusable catalog + planner: elementary bb.showhiddenobjects unlock for catalog/hidden list items; careers.promote deposits into Household Inventory; optional Better BuildBuy UX only — never a substitute for the elementary unlock",
    "operator_correction": "bb.showhiddenobjects IS ELEMENTARY to unlocking the hidden items on the operator list"
  },
  "activation": {
    "require_explicit_activate": true,
    "never_on_startup": true,
    "never_autorun": true,
    "never_touch_game_speed": true,
    "cli": {
      "catalog": "python -m scripts.household_object_force catalog",
      "plan": "python -m scripts.household_object_force plan --item-id ID_OR_all",
      "elementary-unlock": "python -m scripts.household_object_force elementary-unlock"
    }
  },
  "elementary_unlock": {
    "required_for": ["catalog_search", "fabrication_recipe", "hidden_debug_item"],
    "never_substituted_by": [
      "twistedmexi_better_buildbuy",
      "gsi_create_obj",
      "mccc_spawn_by_name",
      "hallucinated_instance_hex"
    ],
    "open_console_chord": ["CTRL", "SHIFT", "C"],
    "open_console_chord_label": "Ctrl+Shift+C",
    "activate_testing_cheats": "testingcheats true",
    "activate_testing_cheats_alias": "testingcheats enabled true",
    "show_hidden_objects": "bb.showhiddenobjects",
    "one_command_per_line": true,
    "player_lines": [
      "testingcheats true",
      "bb.showhiddenobjects"
    ],
    "forbidden_typable_forms": [
      "bb.showhiddenobjects / buydebug",
      "bb.showhiddenobjects/buydebug",
      "buydebug",
      "objects.gsi_create_obj",
      "gsi_create_obj"
    ]
  },
  "inventory_rules": {
    "large_objects_forbidden_destinations": ["PERSONAL_POCKET"],
    "allowed_destinations": ["HOUSEHOLD_INVENTORY", "LOT_PLACEMENT"],
    "note": "UFO Bed, Out of This World Desktop, Cruelty-Free Meat Wall and similar large objects cannot live in a Sim pocket inventory."
  },
  "optional_catalog_ux": {
    "id": "twistedmexi_better_buildbuy",
    "role": "OPTIONAL_CATALOG_UX_ONLY",
    "never_replaces_elementary_unlock": true,
    "helps_with": ["Organized Debug filter", "named search when vanilla debug catalog is blank"],
    "required": false
  },
  "forbidden_always": [
    "HALLUCINATED_INSTANCE_HEX",
    "objects.gsi_create_obj_WITHOUT_EXTRACTED_ID",
    "MCCC_SPAWN_BY_NAME_ASSUMPTION",
    "SUBSTITUTE_BBB_FOR_SHOW_HIDDEN_OBJECTS",
    "SKIP_ELEMENTARY_UNLOCK_FOR_CATALOG_PATH",
    "PERSONAL_POCKET_FOR_LARGE_OBJECT",
    "SLASH_JOIN_CONSOLE",
    "TYPE_BUYDEBUG",
    "TOUCH_GAME_SPEED",
    "AUTORUN_ON_HOST_BOOT",
    "EDIT_USER_SAVE"
  ],
  "useful_item_catalog": [
